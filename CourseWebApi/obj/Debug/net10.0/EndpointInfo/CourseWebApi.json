{
  "openapi": "3.0.4",
  "info": {
    "title": "CourseWebApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Role/roleAll": {
      "get": {
        "tags": [
          "Role"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RoleListVm"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleListVm"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleListVm"
                }
              }
            }
          }
        }
      }
    },
    "/api/Role/roleById/{id}": {
      "get": {
        "tags": [
          "Role"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RoleDetailsVm"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleDetailsVm"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleDetailsVm"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RoleDetailsVm": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "roleName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "RoleListVm": {
        "type": "object",
        "properties": {
          "roleListDto": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleLookupDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RoleLookupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Role"
    }
  ]
}