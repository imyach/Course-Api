<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:CourseDesktopClient.View"
                    xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters">



    <!-- ========== СТИЛЬ ДЛЯ МЕНЮ ПРОФИЛЯ ========== -->
    <Style x:Key="ProfileMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

<!-- ========== СТИЛЬ ДЛЯ ЗАГОЛОВКА МЕНЮ (ИМЯ ПОЛЬЗОВАТЕЛЯ) ========== -->
<Style x:Key="MenuHeaderStyle" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,8,12,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="contentPresenter"
                                          Grid.Column="0"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>

                        </Grid>
                    </Border>

                    <!-- Popup для выпадающего меню -->
                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=border}"
                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                        <Border Background="White"
                                BorderBrush="{StaticResource SecondaryGreenBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="5"
                                Effect="{StaticResource DropShadowEffect}">
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Popup>
                </Grid>

                <ControlTemplate.Triggers>
                    <!-- При открытом меню - текст и стрелка белые -->
                    <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource LightGreenBrush}"/>
                        <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="White"/>

                        </Trigger>

                    <!-- При наведении -->
                        <Trigger Property="IsMouseOver" Value="True">


                            <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border" 
                            Storyboard.TargetProperty="Background.Color" 
                            To="{StaticResource LightGreen}" 
                            Duration="0:0:0.3">
                                        <ColorAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </ColorAnimation.EasingFunction>
                                    </ColorAnimation>
                                        <ColorAnimation Storyboard.TargetName="contentPresenter" 
                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="White" 
                            Duration="0:0:0.3"/>
                                    </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="border" 
                            Storyboard.TargetProperty="Background.Color" 
                            To="Transparent" 
                            Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="contentPresenter" 
                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="{StaticResource TextPrimary}" 
                            Duration="0:0:0.3"/>
                                    </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                        </Trigger>



                        <!-- При нажатии -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryGreenBrush}"/>
                            <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="White"/>
                        </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

    <!-- ========== БАЗОВЫЙ СТИЛЬ ДЛЯ ПУНКТОВ МЕНЮ С ИКОНКОЙ ========== -->
    <Style x:Key="MenuItemBaseStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="15,4,30,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Заголовок слева -->
                            <ContentPresenter x:Name="contentPresenter"
                                          Grid.Column="0"
                                          ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>

                            <!-- Иконка справа с конвертером -->
                            <Image x:Name="iconImage"
                               Grid.Column="1"
                               Source="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Tag, Converter={x:Static conveters:StringToImageSourceConverter.Instance}}"
                               Width="25"
                               Height="25"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               Visibility="Collapsed">
                                <!-- Добавляем RenderTransform для анимации -->
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Показываем иконку если Tag не пустой -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={x:Static conveters:IsStringEmptyConverter.Instance}}" Value="False">
                            <Setter TargetName="iconImage" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <!-- Скрываем иконку если Tag пустой -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={x:Static conveters:IsStringEmptyConverter.Instance}}" Value="True">
                            <Setter TargetName="iconImage" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <!-- Триггер для наведения -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                    Storyboard.TargetProperty="Background.Color" 
                                                    To="{StaticResource LightGreen}" 
                                                    Duration="0:0:0.3">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <ColorAnimation Storyboard.TargetName="contentPresenter" 
                                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                                    To="White" 
                                                    Duration="0:0:0.3"/>
                                        <!-- Анимация иконки при наведении -->
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="Opacity" 
                                                     To="1" 
                                                     Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                    Storyboard.TargetProperty="Background.Color" 
                                                    To="Transparent" 
                                                    Duration="0:0:0.3"/>
                                        <ColorAnimation Storyboard.TargetName="contentPresenter" 
                                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                                    To="{StaticResource TextPrimary}" 
                                                    Duration="0:0:0.3"/>
                                        <!-- Иконка возвращается к исходному состоянию -->
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="Opacity" 
                                                     To="0.9" 
                                                     Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Триггер для нажатия -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                    Storyboard.TargetProperty="Background.Color" 
                                                    To="{StaticResource SecondaryGreen}" 
                                                    Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <ColorAnimation Storyboard.TargetName="contentPresenter" 
                                             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                             To="White" 
                                             Duration="0:0:0.3">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                        <!-- Эффект нажатия на иконку -->
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                     To="0.9" 
                                                     Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                     To="0.9" 
                                                     Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                    Storyboard.TargetProperty="Background.Color" 
                                                    To="{StaticResource LightGreen}" 
                                                    Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                     To="1" 
                                                     Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                     Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                     To="1" 
                                                     Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Триггер для фокуса с клавиатуры -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="White"/>
                        </Trigger>

                        <!-- Триггер для отключенного состояния -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter TargetName="iconImage" Property="Opacity" Value="0.3"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ========== СТИЛИ ДЛЯ ПУНКТОВ МЕНЮ С ЛОГИКОЙ СТРАНИЦ ========== -->
    <Style x:Key="ProfileMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:ProfilePage}}" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkshopMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:WorkshopPage}}" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MyCoursesMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:MyCoursePage}}" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LogoutMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:LoginPage}}" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>