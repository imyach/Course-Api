<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:CourseDesktopClient.View"
                    xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters">

    <!-- ========== ЗАГОЛОВКИ ========== -->

    <!-- Самый большой заголовок (H1) - для главных страниц -->
    <Style x:Key="H1Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Заголовок второго уровня (H2) - для разделов -->
    <Style x:Key="H2Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Заголовок третьего уровня (H3) - для подразделов -->
    <Style x:Key="H3Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Заголовок четвертого уровня (H4) - для карточек -->
    <Style x:Key="H4Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Заголовок пятого уровня (H5) - для мелких заголовков -->
    <Style x:Key="H5Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ========== ОБЫЧНЫЙ ТЕКСТ ========== -->

    <!-- Основной текст -->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Второстепенный текст (серый) -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Мелкий текст (подписи, метки) -->
    <Style x:Key="SmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ========== СПЕЦИАЛЬНЫЕ СТИЛИ ========== -->

    <!-- Текст с зеленым акцентом (успех) -->
    <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LightGreenBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Текст с красным акцентом (ошибка) -->
    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#D32F2F"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Текст ссылки (как гиперссылка) -->
    <Style x:Key="LinkTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource LightGreenBrush}"/>
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ========== СТИЛИ ДЛЯ КОНКРЕТНЫХ СЛУЧАЕВ ========== -->

    <!-- Заголовок страницы (часто используется) -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource H1Style}">

    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Заголовок карточки -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource H4Style}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>

    <!-- Метка для поля ввода -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Значение в поле (жирное) -->
    <Style x:Key="FieldValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Дата/время (мелкий серый) -->
    <Style x:Key="DateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Счетчик (например, "5 из 10") -->
    <Style x:Key="CounterStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Цена/процент (жирный зеленый) -->
    <Style x:Key="PriceStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource LightGreenBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ========== СТИЛЬ ДЛЯ ССЫЛКИ РЕГИСТРАЦИЯ (ВХОДА) ========== -->
    <Style x:Key="RegisterLinkStyle" TargetType="TextBlock">
        <!-- Основные настройки -->
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- При наведении - только цвет -->
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Плавное изменение цвета -->
                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                  To="{StaticResource LightGreen}" 
                                  Duration="0:0:0.2">
                            <ColorAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </ColorAnimation.EasingFunction>
                        </ColorAnimation>

                        <!-- Плавное появление подчеркивания через Opacity -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                   To="1" 
                                   Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Плавное возвращение цвета -->
                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                  To="{StaticResource TextSecondary}" 
                                  Duration="0:0:0.2">
                            <ColorAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </ColorAnimation.EasingFunction>
                        </ColorAnimation>

                        <!-- Плавное исчезновение подчеркивания -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                   To="0.7" 
                                   Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <!-- Возврат размера (на случай, если отпустили вне элемента) -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                   To="1" 
                                   Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                   To="1" 
                                   Duration="0:0:0.1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <!-- При нажатии - темно-зеленый цвет и уменьшение -->
            <EventTrigger RoutedEvent="MouseLeftButtonDown">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Темно-зеленый цвет -->
                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                  To="#1B5E20" 
                                  Duration="0:0:0.1"/>

                        <!-- Уменьшение -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                   To="0.95" 
                                   Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                   To="0.95" 
                                   Duration="0:0:0.1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="MouseLeftButtonUp">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Возврат цвета зависит от того, находится ли мышь над элементом -->
                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                  To="{StaticResource LightGreen}" 
                                  Duration="0:0:0.1"/>

                        <!-- Возврат размера -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                   To="1" 
                                   Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                   To="1" 
                                   Duration="0:0:0.1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ========== СТИЛИ ДЛЯ НАВИГАЦИИ ========== -->

    <!-- Стиль для ссылок навигации -->
    <Style x:Key="NavLinkStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для ссылки входа (на основе NavLinkStyle) -->
    <Style x:Key="LoginLinkStyle" TargetType="TextBlock" BasedOn="{StaticResource NavLinkStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,5,10,5"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ========== СТИЛЬ ДЛЯ ТЕКСТА НАВИГАЦИОННЫХ КНОПОК ========== -->
    <Style x:Key="NavButtonTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        

        <Style.Resources>
            <!-- Анимация для цвета текста при наведении -->
            <Storyboard x:Key="HoverTextAnimation">
                <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="{StaticResource DarkGray}" 
                            Duration="0:0:0.2">
                    <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </ColorAnimation.EasingFunction>
                </ColorAnimation>
            </Storyboard>

            <!-- Анимация для цвета текста при уходе мыши -->
            <Storyboard x:Key="HoverLeaveTextAnimation">
                <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="{StaticResource TextPrimary}" 
                            Duration="0:0:0.2">
                    <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </ColorAnimation.EasingFunction>
                </ColorAnimation>
            </Storyboard>

            <!-- Анимация для активного состояния (белый текст) -->
            <Storyboard x:Key="ActiveTextAnimation">
                <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="White" 
                            Duration="0:0:0.2">
                    <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </ColorAnimation.EasingFunction>
                </ColorAnimation>
            </Storyboard>

            <!-- Анимация для неактивного состояния -->
            <Storyboard x:Key="InactiveTextAnimation">
                <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                            To="{StaticResource TextPrimary}" 
                            Duration="0:0:0.2">
                    <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </ColorAnimation.EasingFunction>
                </ColorAnimation>
            </Storyboard>
        </Style.Resources>

        <Style.Triggers>
            <!-- Анимация при наведении -->
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource HoverTextAnimation}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource HoverLeaveTextAnimation}"/>
            </EventTrigger>

            <!-- Активное состояние по триггеру страницы (белый текст) -->
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:AllCoursePage}}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:MyCoursePage}}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentView, Converter={x:Static conveters:TypeEqualsConverter.Instance}, ConverterParameter={x:Type view:AllUsersPage}}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для текста активной кнопки (белый текст) -->
    <Style x:Key="ActiveNavButtonTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NavButtonTextStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    
    <Style x:Key="CourseInfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="CourseInfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="CourseRatingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LightGreenBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="CourseReviewsStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- ========== СТИЛЬ ДЛЯ ЭЛЕМЕНТА С МНОГОТОЧИЕМ ========== -->
    <Style x:Key="EllipsisItemStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>


</ResourceDictionary>