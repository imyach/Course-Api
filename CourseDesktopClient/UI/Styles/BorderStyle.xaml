    <!-- Локальные стили для карточки -->
    <Style x:Key="CourseCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightGrayBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" 
                                      ShadowDepth="2" 
                                      Opacity="0.1" 
                                      Direction="270"
                                      Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="450"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Margin" Value="16"/>
    </Style>

