                                          ShadowDepth="0"
                                          Opacity="0"
                                          Color="{StaticResource PrimaryGreen}"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                            <!-- Иконка пользователя -->
                            <TextBlock x:Name="iconText" 
                                   Text="👤" 
                                   FontSize="16"
                                   Margin="0,0,8,0"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"/>

                            <!-- Текст кнопки -->
                            <ContentPresenter x:Name="content"
                                          Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <!-- Плавное изменение цвета фона на более светлый зеленый -->
                                        <ColorAnimation Duration="0:0:0.2"
                                                    To="{StaticResource LightGreen}"
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="Background.Color"/>

                                        <!-- Появление тени -->
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="8"
                                                     Storyboard.TargetName="shadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"/>
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="2"
                                                     Storyboard.TargetName="shadowEffect"
                                                     Storyboard.TargetProperty="ShadowDepth"/>
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="0.25"
                                                     Storyboard.TargetName="shadowEffect"
                                                     Storyboard.TargetProperty="Opacity"/>

                                        <!-- Небольшое увеличение -->
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="1.03"
                                                     Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="1.03"
                                                     Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleY"/>

                                        <!-- Анимация иконки (легкое движение) -->
                                        <DoubleAnimation Duration="0:0:0.2"
                                                     To="3"
                                                     Storyboard.TargetName="iconText"
                                                     Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <!-- Цвет при нажатии (более темный зеленый) -->
                                        <ColorAnimation Duration="0:0:0.1"
                                                    To="{StaticResource SecondaryGreen}"
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="Background.Color"/>

                                        <!-- Уменьшение при нажатии -->
                                        <DoubleAnimation Duration="0:0:0.1"
                                                     To="0.97"
                                                     Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleX"/>
                                        <DoubleAnimation Duration="0:0:0.1"
                                                     To="0.97"
                                                     Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="RenderTransform.ScaleY"/>

                                        <!-- Уменьшение тени -->
                                        <DoubleAnimation Duration="0:0:0.1"
                                                     To="4"
                                                     Storyboard.TargetName="shadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"/>

                                        <!-- Возврат иконки -->
                                        <DoubleAnimation Duration="0:0:0.1"
                                                     To="0"
                                                     Storyboard.TargetName="iconText"
                                                     Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0"
                                                     To="0.5"
                                                     Storyboard.TargetName="border"
                                                     Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

