<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========== КРУГЛЫЙ CHECKBOX ДЛЯ ЭКРАНА АВТОРИЗАЦИИ ========== -->
    <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
        <!-- Основные настройки -->
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="5,2"/>

        <!-- Добавляем RenderTransform для анимации размера -->
        <Setter Property="RenderTransformOrigin" Value="0,0"/>
        <!-- Центр элемента -->
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>

        <!-- Шаблон для круглого чекбокса -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent"
                      RenderTransformOrigin="0,0">
                        <!-- Добавляем центр для Grid -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Круглая рамка чекбокса -->
                        <Border x:Name="CheckBoxBorder"
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            Background="{StaticResource PureWhiteBrush}"
                            BorderBrush="{StaticResource BorderGrayBrush}"
                            BorderThickness="1.5"
                            Margin="0,0,8,0"
                            RenderTransformOrigin="0,0">
                            <!-- Центр для рамки -->

                            <!-- Зеленый фон для заполнения с галочкой внутри -->
                            <Border x:Name="FillBackground"
                                Background="{StaticResource PrimaryGreenBrush}"
                                CornerRadius="10.25"  
                                Margin="-0.5"
                                Opacity="0"
                                RenderTransformOrigin="0,0">
                                <!-- Центр для фона -->

                                <!-- Белая галочка -->
                                <TextBlock x:Name="CheckMark"
                                       Text="✓"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="0,-1,0,0"/>
                            </Border>
                        </Border>

                        <!-- Текст -->
                        <ContentPresenter x:Name="ContentText"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- При IsChecked = True -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FillBackground" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            <Setter TargetName="ContentText" Property="TextElement.Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                        </Trigger>

                        <!-- При IsChecked = False -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="FillBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
                            <Setter TargetName="ContentText" Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>

                        <!-- При наведении на невыбранный -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LightGreenBrush}"/>
                            <Setter TargetName="ContentText" Property="TextElement.Foreground" Value="{StaticResource LightGreenBrush}"/>
                        </MultiTrigger>

                        <!-- При наведении на выбранный -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            <Setter TargetName="ContentText" Property="TextElement.Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                        </MultiTrigger>

                        <!-- При нажатии - плавная анимация -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Плавное уменьшение -->
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                     To="0.95" 
                                                     Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                     To="0.95" 
                                                     Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Плавное изменение цвета рамки -->
                                        <ColorAnimation Storyboard.TargetName="CheckBoxBorder" 
                                                     Storyboard.TargetProperty="BorderBrush.Color" 
                                                     To="#1B5E20" 
                                                     Duration="0:0:0.17"/>
                                        <!-- Плавное изменение цвета текста -->
                                        <ColorAnimation Storyboard.TargetName="ContentText" 
                                                     Storyboard.TargetProperty="(TextElement.Foreground).Color" 
                                                     To="#1B5E20" 
                                                     Duration="0:0:0.17"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Плавное возвращение размера -->
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                     To="1" 
                                                     Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                     To="1" 
                                                     Duration="0:0:0.17">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- При отключении -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource LightGrayBrush}"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
                            <Setter TargetName="ContentText" Property="TextElement.Foreground" Value="{StaticResource DarkGrayBrush}"/>
                            <Setter TargetName="FillBackground" Property="Background" Value="{StaticResource DarkGrayBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ========== ПРОСТОЙ КРУГЛЫЙ CHECKBOX ========== -->
    <Style x:Key="SimpleRoundCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="CheckBoxBorder"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="{StaticResource PureWhiteBrush}"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1.5"
                                Margin="0,0,8,0">
                            <Border x:Name="FillBackground"
                                    Background="{StaticResource PrimaryGreenBrush}"
                                    CornerRadius="10"
                                    Opacity="0">
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FillBackground" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LightGreenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ========== СТИЛЬ ДЛЯ ЧЕКБОКСА ОТВЕТА ========== -->
    <Style x:Key="AnswerCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Квадрат чекбокса -->
                        <Border x:Name="CheckBoxBorder"
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            CornerRadius="4"
                            Background="{StaticResource PureWhiteBrush}"
                            BorderBrush="{StaticResource BorderGrayBrush}"
                            BorderThickness="1"
                            Margin="0,0,8,0">

                            <!-- Галочка -->
                            <TextBlock x:Name="CheckMark"
                                   Text="✓"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        </Border>

                        <!-- Содержимое (текст) -->
                        <ContentPresenter Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- При наведении -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource LightGreenBrush}"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>

                        <!-- При нажатии -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                        </Trigger>

                        <!-- При выборе -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="1"/>
                        </Trigger>

                        <!-- При отключении -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>