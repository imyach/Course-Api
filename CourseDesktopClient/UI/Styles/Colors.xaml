<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    
    <!-- ========== ОСНОВНОЙ ЗЕЛЕНЫЙ (Спокойный, приятный) ========== -->
    <Color x:Key="PrimaryGreen">#2E7D32</Color>
    <!-- Темно-зеленый для акцентов -->
    <Color x:Key="SecondaryGreen">#388E3C</Color>
    <!-- Средне-зеленый для кнопок -->
    <Color x:Key="LightGreen">#4CAF50</Color>
    <!-- Светло-зеленый для иконок -->
    <Color x:Key="SoftGreen">#E8F5E9</Color>
    <!-- Мягкий зеленый для фонов -->
    <Color x:Key="PaleGreen">#a1ee8b</Color>
    <!-- Бледно-зеленый для разделителей -->
    <Color x:Key="PaleMoreGreen">#ccffcc</Color>
    <!-- ========== НЕЙТРАЛЬНЫЕ (Теплые, уютные) ========== -->
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <!-- Чистый белый -->
    <Color x:Key="OffWhite">#FAFAFA</Color>
    <!-- Теплый белый для фонов -->
    <Color x:Key="LightGray">#F5F5F5</Color>
    <!-- Светло-серый для карточек -->
    <Color x:Key="MediumGray">#E0E0E0</Color>
    <!-- Серый для границ -->
    <Color x:Key="BorderGray">#BDBDBD</Color>
    <!-- Темно-серый для рамок -->
    <Color x:Key="DarkGray">#757575</Color>
    <!-- Темно-серый для текста -->
    <Color x:Key="TextPrimary">#424242</Color>
    <!-- Основной текст (мягкий черный) -->
    <Color x:Key="TextSecondary">#9E9E9E</Color>
    <!-- Второстепенный текст -->



    <!-- ========== ДОПОЛНИТЕЛЬНЫЕ ЦВЕТА (Аккуратные) ========== -->
    <Color x:Key="SoftBlue">#E3F2FD</Color>
    <!-- Мягкий синий для информации -->
    <Color x:Key="SoftRed">#FFEBEE</Color>
    <!-- Мягкий красный для ошибок -->
    <Color x:Key="SoftYellow">#fcf0ca</Color>
    <!-- Мягкий желтый для предупреждений -->
    <Color x:Key="SoftPurple">#F3E5F5</Color>
    <!-- Мягкий фиолетовый для акцентов -->

    <!-- ========== АКЦЕНТНЫЕ ЦВЕТА ========== -->
    <Color x:Key="AccentBlue">#2196F3</Color>
    <!-- Синий для ссылок -->
    <Color x:Key="AccentRed">#F44336</Color>
    <!-- Красный для ошибок -->
    <Color x:Key="AccentOrange">#FF9800</Color>
    <!-- Оранжевый для предупреждений -->
    <Color x:Key="AccentYellow">#e0c500</Color>

    <!-- ========== КИСТИ (Используются в XAML) ========== -->

    <!-- Зеленые -->
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="{StaticResource PrimaryGreen}"/>
    <SolidColorBrush x:Key="SecondaryGreenBrush" Color="{StaticResource SecondaryGreen}"/>
    <SolidColorBrush x:Key="LightGreenBrush" Color="{StaticResource LightGreen}"/>
    <SolidColorBrush x:Key="SoftGreenBrush" Color="{StaticResource SoftGreen}"/>
    <SolidColorBrush x:Key="PaleGreenBrush" Color="{StaticResource PaleGreen}"/>
    <SolidColorBrush x:Key="PaleMoreGreenBrush" Color="{StaticResource PaleMoreGreen}"/>

    <!-- Нейтральные -->
    <SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhite}"/>
    <SolidColorBrush x:Key="OffWhiteBrush" Color="{StaticResource OffWhite}"/>
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGray}"/>
    <SolidColorBrush x:Key="MediumGrayBrush" Color="{StaticResource MediumGray}"/>
    <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGray}"/>
    <SolidColorBrush x:Key="DarkGrayBrush" Color="{StaticResource DarkGray}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>

    <!-- Фоновые -->
    <SolidColorBrush x:Key="SoftBlueBrush" Color="{StaticResource SoftBlue}"/>
    <SolidColorBrush x:Key="SoftRedBrush" Color="{StaticResource SoftRed}"/>
    <SolidColorBrush x:Key="SoftYellowBrush" Color="{StaticResource SoftYellow}"/>
    <SolidColorBrush x:Key="SoftPurpleBrush" Color="{StaticResource SoftPurple}"/>

    <!-- Акцентные -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="StarsYellowBrush" Color="{StaticResource AccentYellow}"/>

    <!-- ========== ДОПОЛНИТЕЛЬНЫЕ ЦВЕТА ДЛЯ АВАТАРОВ ПО РОЛЯМ ========== -->

    <!-- Для АДМИНА (красная тема) -->
    <Color x:Key="AdminBg">#FFEBEE</Color>
    <!-- Мягкий красный фон -->
    <Color x:Key="AdminText">#C62828</Color>
    <!-- Темно-красный текст -->

    <!-- Для ПРЕПОДА (желтая/оранжевая тема) -->
    <Color x:Key="TeacherBg">#fedf80</Color>
    <!-- Мягкий желтый фон -->
    <Color x:Key="TeacherText">#dba500</Color>
    <!-- Темно-оранжевый текст -->

    <!-- Для СТУДЕНТА (зеленая тема) - уже есть, но можно явно добавить -->
    <Color x:Key="StudentBg">#E8F5E9</Color>
    <!-- Мягкий зеленый фон (SoftGreen) -->
    <Color x:Key="StudentText">#2E7D32</Color>
    <!-- Темно-зеленый текст (PrimaryGreen) -->


    <!-- ========== СООТВЕТСТВУЮЩИЕ КИСТИ ========== -->

    <!-- Админ -->
    <SolidColorBrush x:Key="AdminBgBrush" Color="{StaticResource AdminBg}"/>
    <SolidColorBrush x:Key="AdminTextBrush" Color="{StaticResource AdminText}"/>

    <!-- Препод -->
    <SolidColorBrush x:Key="TeacherBgBrush" Color="{StaticResource TeacherBg}"/>
    <SolidColorBrush x:Key="TeacherTextBrush" Color="{StaticResource TeacherText}"/>

    <!-- Студент (опционально, можно использовать существующие) -->
    <SolidColorBrush x:Key="StudentBgBrush" Color="{StaticResource StudentBg}"/>
    <SolidColorBrush x:Key="StudentTextBrush" Color="{StaticResource StudentText}"/>

</ResourceDictionary>