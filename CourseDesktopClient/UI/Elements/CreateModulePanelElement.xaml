<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateModulePanelElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="300"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource CourseCardBorderStyle}"
            Width="340"
            Height="Auto"
            MinHeight="180"
            MaxHeight="240"
            Margin="15"
            Padding="20"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto" MaxHeight="80"/>
                <!-- Описание -->
                <RowDefinition Height="Auto"/>
                <!-- Порядковый номер -->
                <RowDefinition Height="Auto"/>
                <!-- Разделитель -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <!-- Заголовок модуля -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Style="{StaticResource H4Style}"
                       FontSize="16"
                       FontWeight="Bold"
            MaxHeight="20"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Описание модуля -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Description}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="60"
                       Margin="0,0,0,8"/>

            <!-- Порядковый номер -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        Margin="0,0,0,12">
                <TextBlock Text="🔢" 
                           FontSize="14"
                           Foreground="{StaticResource PrimaryGreenBrush}"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Order, StringFormat='Порядковый номер: {0}'}" 
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Разделитель -->
            <Rectangle Grid.Row="3" 
                       Height="1" 
                       Fill="{StaticResource BorderGrayBrush}" 
                       Opacity="0.3"
                       Margin="0,0,0,12"/>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0">

                <!-- Кнопка редактирования -->
                <Button Content="✎ Редактировать"
                        Command="{Binding DataContext.LocalCreateModuleCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource EditPasswordButtonStyle}"
                        Height="32"
                        Padding="12,6"
                        FontSize="11"
                        Margin="0,0,8,0"/>

                <!-- Кнопка удаления -->
                <Button Content="🗑️ Удалить"
                        Command="{Binding DataContext.DeteleModuleCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DeleteIconButtonStyle}"
                        Height="32"
                        Padding="12,6"
                        FontSize="11"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>