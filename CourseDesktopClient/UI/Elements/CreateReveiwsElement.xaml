<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateReveiwsElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controlls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450">
    <Border 
         Margin="10" 
        Height="auto"  >
        <Grid >
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Stretch" 
                        MaxWidth="800">
                <Grid Width="auto" >
                    <TextBlock Text="Написать отзыв" HorizontalAlignment="Left"/>
                    <controlls:RatingStarsControl HorizontalAlignment="Right" 
                        RatingCommand="{Binding RatingCommand}"
                        ResetRating="{Binding ShouldResetRating}"/>
                </Grid>
                <TextBox  Height="18" Text="{Binding ReviewUserText}" />
                <Button Content="Отправить" Command="{Binding SendReviewCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
