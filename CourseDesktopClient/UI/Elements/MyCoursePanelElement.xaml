<UserControl x:Class="CourseDesktopClient.UI.Elements.MyCoursePanelElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
                          d:DesignHeight="300" d:DesignWidth="380" >

    <Border Background="LightGray" 
            BorderBrush="#E0E0E0" 
            BorderThickness="0 0 0 1"
            Padding="20"
            CornerRadius="20"
            Width="380"
            Height="Auto"
            MaxHeight="300"
            Margin="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MaxHeight="121"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding Description}" 
                       Foreground="#666"
                       TextWrapping="WrapWithOverflow"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="89" 
                       Height="Auto"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding CreatedBy, StringFormat='Автор: {0}'}" 
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StartedAt, StringFormat='Записан: {0:dd.MM.yyyy}'}" 
                           Foreground="#666"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding FinishedAt, StringFormat='Пройден: {0:dd.MM.yyyy}'}" 
                           Foreground="#666"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FinishedAt}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock Grid.Row="4"
           Text="{Binding Status}" 
           Foreground="#666"
           TextWrapping="WrapWithOverflow"
           TextTrimming="CharacterEllipsis"
           MaxHeight="89" 
           Height="Auto"
           Margin="0,0,0,8"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center">

                <Button Content="Удалить курс"
        Command="{Binding DataContext.DeleteProgressCourseCommand, 
                RelativeSource={RelativeSource 
                AncestorType=UserControl, 
                AncestorLevel=2}}"
        CommandParameter="{Binding}"
        Padding="12,6"
        Margin="0,0,8,0"/>
                <Button Content="Продолжить прохождение"
                        Command="{Binding DataContext.ContinueCousre, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        Visibility="{Binding ContinueCousreVisible}"
                        CommandParameter="{Binding}"
                        Padding="12,6"
                        Margin="0,0,8,0"/>

                <Button Content="Подробнее"
                        Command="{Binding DataContext.ViewDetailsCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

