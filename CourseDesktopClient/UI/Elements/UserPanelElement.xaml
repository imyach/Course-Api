<UserControl x:Class="CourseDesktopClient.UI.Elements.UserPanelElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controlls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="#FFC1C1C1" 
        BorderBrush="#E0E0E0" 
        BorderThickness="0 0 0 1"
        Padding="20"
        CornerRadius="20"
        HorizontalAlignment="Stretch"
        Height="Auto"
        MaxHeight="130"
        Margin="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MaxHeight="121"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    
                    <TextBlock Grid.Row="0"
                       Text="{Binding NameUser}" 
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="0"
                        Text="{Binding IsCurrentUser}" 
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#333"
                        VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Grid.Row="1"
                   Text="{Binding Role.Name, StringFormat='Роль: {0}'}" 
                   Foreground="#666"
                   TextWrapping="WrapWithOverflow"
                   Margin="0,8,0,8"/>

                <TextBlock Grid.Row="2"
                   Text="{Binding CreatedAt, StringFormat='Зарегестрирован: {0:dd.MM.yyyy}'}" 
                   Foreground="#666"
                   HorizontalAlignment="Right"/>
                <Button Content="Посмотреть профиль" Grid.Row="3"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
