<UserControl x:Class="CourseDesktopClient.UI.Elements.CoursePanelElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="400" >
    <Border Background="LightGray" 
            BorderBrush="#E0E0E0" 
            BorderThickness="0 0 0 1"
            Padding="20"
            CornerRadius="20"
            Width="400"
            Height="380"
            Margin="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Title}" 
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding Description}" 
                       Foreground="#666"
                       Margin="0 8 0 0"
                       TextWrapping="Wrap"
                       Grid.ColumnSpan="2"/>
            
            <TextBlock Grid.Row="2"
                        Text="{Binding User.NameUser ,StringFormat='Создатель: {0}'}" 
                        Foreground="#666"
                        Margin="0 8 0 0"
                        TextWrapping="Wrap"
                        Grid.ColumnSpan="2"/>

            <Grid Grid.Row="3">
                <TextBlock 
                        Text="{Binding CreatedAt , StringFormat='Создан: {0:dd.MM.yyyy}'}" 
                        Foreground="#666"
                        Margin="0 8 0 0"
                        TextWrapping="Wrap"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"/>

                <TextBlock 
                        Text="{Binding UpdateAt, StringFormat='Последнее обновление: {0:dd.MM.yyyy}'}" 
                        Foreground="#666"
                        Margin="0 8 0 0"
                        TextWrapping="Wrap"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateAt}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            
            <TextBlock Grid.Row="4"
            Text="{Binding Rait,StringFormat='Рейтинг курса: {0}'}" 
            Foreground="#666"
            Margin="0 8 0 0"
            TextWrapping="Wrap"
            HorizontalAlignment="Right"/>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="16 0 0 0">

                <Button x:Name="DetailsButton"
                        Content="Подробнее"
                        Command="{Binding DataContext.ViewDetailsCommand, 
                        RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}"
                        Padding="12 6"
                        Margin="0 0 8 0"/>

                <Button x:Name="EnrollButton"
                        Content="Записаться"
                        Command="{Binding EnrollCommand}"
                        Padding="12 6"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
