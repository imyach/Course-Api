<UserControl x:Class="CourseDesktopClient.UI.Elements.MyCoursePanelForProfileElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="720"
             Background="Transparent">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource CourseCardBorderStyle}"
            MinWidth="820"
            MaxWidth="1200"
            Height="Auto"
            MaxHeight="180"
            Margin="10"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Описание -->
                <RowDefinition Height="Auto"/>
                <!-- Автор -->
                <RowDefinition Height="Auto"/>
                <!-- Статус -->
            </Grid.RowDefinitions>

            <!-- Заголовок курса -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Style="{StaticResource H4Style}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Описание курса -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Description}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40"
                       Margin="0,0,0,8"/>

            <!-- Автор курса -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="👤 " 
                           FontSize="14"
                           Foreground="{StaticResource PrimaryGreenBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CreatedBy, StringFormat='Автор: {0}'}" 
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Статус курса с цветовой индикацией -->
            <Border Grid.Row="3"
                    x:Name="StatusBorder"
                    CornerRadius="12"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Статус по умолчанию (опубликован) - зеленый -->
                        <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                        <Style.Triggers>
                            <!-- Статус "В разработке" - синий -->
                            <DataTrigger Binding="{Binding Status}" Value="В разработке">
                                <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
                            </DataTrigger>
                            <!-- Статус "В архиве" - серый -->
                            <DataTrigger Binding="{Binding Status}" Value="В архиве">
                                <Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="В прохождении">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>