<UserControl x:Class="CourseDesktopClient.UI.Elements.MyCoursePanelForProfileElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="720" >

    <Border Background="LightGray" 
            BorderBrush="#E0E0E0" 
            BorderThickness="0 0 0 1"
            Padding="20"
            CornerRadius="20"
            MinWidth="820"
            MaxWidth="1500"
            Height="Auto"
            MaxHeight="200"
            Margin="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="{Binding Description}" 
                       Foreground="#666"
                       TextWrapping="WrapWithOverflow"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40" 
                       Height="Auto"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding CreatedBy, StringFormat='Автор: {0}'}" 
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3"
           Text="{Binding Status}" 
           Foreground="#666"
           TextWrapping="WrapWithOverflow"
           TextTrimming="CharacterEllipsis"
           MaxHeight="89" 
           Height="Auto"
           Margin="0,0,0,8"/>
        </Grid>
    </Border>
</UserControl>
