<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateAnswerElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="LightGray" 
            BorderBrush="#E0E0E0" 
            BorderThickness="0 0 0 1"
            Padding="14"
            CornerRadius="20"
            MaxHeight="90"
            Margin="20">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0"
                       Text="{Binding Text}" 
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#333"
                       Margin="0,0,0,8"
                       VerticalAlignment="Center" />

            <CheckBox Grid.Row="1"
                      IsChecked="{Binding IsCorrect}"
                         Grid.Column="1" 
                      Content="Правильный ли"
                      VerticalContentAlignment="Center" 
                      HorizontalContentAlignment="Left"
                      HorizontalAlignment="Right"
                       Margin="0 0 40 0" VerticalAlignment="Center"
                      FlowDirection="RightToLeft"/>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Grid.Column="2">

                <Button Content="Сохранить"
                        Command="{Binding DataContext.LocalSaveAnswerCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        
                        CommandParameter="{Binding}"
                        Padding="12,6"
                        Margin="0,0,8,0"/>

                <Button Content="Удалить"
                    Command="{Binding DataContext.LocalDeleteAnswerCommand, 
                            RelativeSource={RelativeSource 
                            AncestorType=UserControl, 
                            AncestorLevel=2}}"
                    
                    CommandParameter="{Binding}"
                    Padding="12,6"
        Margin="0,0,8,0"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
