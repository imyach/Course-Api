<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateAnswerElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource AnswerCardBorderStyle}"
            Width="Auto"
            MinWidth="600"
            HorizontalAlignment="Stretch"
            Height="Auto"
            MinHeight="80"
            MaxHeight="100"
            Margin="10"
            Padding="15"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - текст ответа -->
            <TextBox Grid.Column="0"
                     Text="{Binding Text}"
                     Style="{StaticResource ReviewTextBoxStyle}"
                     Tag="Введите вариант ответа..."
                     FontSize="14"
                     VerticalAlignment="Center"
                     Margin="0,0,15,0"
                     SnapsToDevicePixels="True"/>

            <!-- Сообщение об ошибке -->
            <TextBlock
                Grid.Column="1" Text="{Binding MistakeAnswerText}" 
                   Style="{StaticResource ErrorTextStyle}"
            Visibility="{Binding VisibleAnswerMisstake}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
            <!-- Средняя часть - чекбокс правильности -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,0">

                <CheckBox x:Name="CorrectCheckBox"
                          IsChecked="{Binding IsCorrect}"
                          Style="{StaticResource AnswerCheckBoxStyle}"
                          Content="Правильный"
                          VerticalContentAlignment="Center"
                          FlowDirection="LeftToRight"
                          SnapsToDevicePixels="True"/>
            </StackPanel>

            <!-- Правая часть - кнопки действий -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                <!-- Кнопка сохранения -->
                <Button Command="{Binding DataContext.LocalSaveAnswerCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource SaveAnswerIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,5,0"
                        ToolTip="Сохранить ответ"/>

                <!-- Кнопка удаления -->
                <Button Command="{Binding DataContext.LocalDeleteAnswerCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DeleteIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTip="Удалить ответ"/>
                
            </StackPanel>
        </Grid>
    </Border>
</UserControl>