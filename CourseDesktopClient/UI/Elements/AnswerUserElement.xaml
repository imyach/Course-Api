<UserControl x:Class="CourseDesktopClient.UI.Elements.AnswerUserElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter"
                                            TrueBrush="{StaticResource PrimaryGreenBrush}"
                                            FalseBrush="{StaticResource AccentRedBrush}"/>

        <converters:BooleanToIconConverter x:Key="BooleanToIconConverter"
                                           TrueIcon="✓"
                                           FalseIcon="✗"/>

        <!-- Добавлен недостающий конвертер для цвета текста -->
        <converters:BooleanToBrushConverter x:Key="BooleanToTextColorConverter"
                                            TrueBrush="{StaticResource PrimaryGreenBrush}"
                                            FalseBrush="{StaticResource AccentRedBrush}"/>
    </UserControl.Resources>

    <Grid>
        <Border BorderBrush="#E0E0E0" 
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,15"
                Background="White">

            <StackPanel>
                <!-- Вопрос и результат -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding QuestionText}"
                               FontSize="14" 
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <!-- Бейдж с результатом -->
                    <Border Grid.Column="1"
                            Background="{Binding IsCorrect, Converter={StaticResource BooleanToBrushConverter}}"
                            CornerRadius="3"
                            Margin="15"
                            VerticalAlignment="Center"
                            Padding="8,3">
                        <TextBlock Text="{Binding Score, StringFormat='{}{0}%'}" 
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- Правильные ответы (из БД) -->
                <TextBlock Text="Правильные ответы:" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryGreenBrush}"
                           Margin="0,10,0,5"/>

                <ItemsControl ItemsSource="{Binding CorrectAnswers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SoftGreenBrush}"
                                    BorderBrush="{StaticResource PrimaryGreenBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,5"
                                    Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Галочка правильного ответа -->
                                    <TextBlock Grid.Column="0"
                                               Text="✓"
                                               Foreground="{StaticResource PrimaryGreenBrush}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,0,10,0"/>

                                    <!-- Текст ответа -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AnswerText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Разделитель -->
                <Border Height="1" 
                        Background="{StaticResource BorderGrayBrush}" 
                        Opacity="0.3"
                        Margin="0,15,0,15"/>

                <!-- Ваши ответы -->
                <TextBlock Text="Ваши ответы:" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5"/>

                <ItemsControl ItemsSource="{Binding UserAnswers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,5"
                                    Margin="0,2,0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PureWhiteBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource SoftRedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка статуса с использованием конвертера -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IsCorrect, Converter={StaticResource BooleanToIconConverter}}"
                                               Foreground="{Binding IsCorrect, Converter={StaticResource BooleanToBrushConverter}}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,0,10,0"/>

                                    <!-- Текст ответа - ИСПРАВЛЕНО: Используем стиль вместо конвертера -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AnswerText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>