<UserControl x:Class="CourseDesktopClient.UI.Elements.ReviewPanelElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controlls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="600"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:FirstLettersConverter x:Key="FirstLettersConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource ReviewCardBorderStyle}"
            Margin="10"
            Padding="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MaxHeight="180"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя строка с автором, рейтингом и кнопкой удаления -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Аватар и имя пользователя -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal">
                    <Border Width="32"
            Height="32"
            CornerRadius="16"
            Margin="0,0,10,0">

                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Значение по умолчанию (студент) - зеленый -->
                                <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>

                                <Style.Triggers>
                                    <!-- Админ - красный фон -->
                                    <DataTrigger Binding="{Binding User.Role.Name}" Value="Admin">
                                        <Setter Property="Background" Value="{StaticResource SoftRedBrush}"/>
                                    </DataTrigger>

                                    <!-- Препод (Couch) - желтый фон -->
                                    <DataTrigger Binding="{Binding User.Role.Name}" Value="Couch">
                                        <Setter Property="Background" Value="{StaticResource SoftYellowBrush}"/>
                                    </DataTrigger>

                                    <!-- Студент - зеленый фон -->
                                    <DataTrigger Binding="{Binding User.Role.Name}" Value="Student">
                                        <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding User.NameUser, Converter={StaticResource FirstLettersConverter}}"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- По умолчанию - зеленый текст (для студента) -->
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>

                                    <Style.Triggers>
                                        <!-- Админ - красный текст -->
                                        <DataTrigger Binding="{Binding User.Role.Name}" Value="Admin">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        </DataTrigger>

                                        <!-- Препод (Couch) - темно-оранжевый текст -->
                                        <DataTrigger Binding="{Binding User.Role.Name}" Value="Couch">
                                            <Setter Property="Foreground" Value="{StaticResource TeacherTextBrush}"/>
                                        </DataTrigger>

                                        <!-- Студент - зеленый текст -->
                                        <DataTrigger Binding="{Binding User.Role.Name}" Value="Student">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding User.NameUser}" 
                               Style="{StaticResource H4Style}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1"/>

                <!-- Рейтинг звездами -->
                <controlls:RatingStarsControl Grid.Column="2" 
                                              Rating="{Binding Rait}"
                                              IsEnabled="False"
                                              Style="{StaticResource RatingStarsStyle}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                <!-- Кнопка удаления (только для автора) -->
                <Button Grid.Column="3"
                        Content="🗑️"
                        FontSize="14"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5,2"
                        Cursor="Hand"
                        ToolTip="Удалить отзыв"
                        Command="{Binding DataContext.DeleteReviewCommand, 
                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding IsCurrentUserReview, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource DeleteIconButtonStyle}"/>

            </Grid>

            <!-- Текст отзыва -->
            <Border Grid.Row="1"
                    Background="{StaticResource OffWhiteBrush}"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,8"
                               Height="auto">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource TextBoxScrollViewerStyle}"
                              Height="auto"
                              MaxHeight="160">
                    <TextBlock
                               Style="{StaticResource BodyTextStyle}"
                                converters:HyperlinkHelper.FormattedText="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               />
                </ScrollViewer>
            </Border>

            <!-- Дата создания -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="📅 " 
                           FontSize="12"
                           Foreground="{StaticResource PrimaryGreenBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" 
                           Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>