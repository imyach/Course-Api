<Window x:Class="CourseDesktopClient.UI.Elements.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="520"
        MinHeight="160"
        MaxHeight="400"
        Title="CustomMessageBox"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
            RenderOptions.EdgeMode="Unspecified"  
RenderOptions.BitmapScalingMode="NearestNeighbor">

    <!-- Анимация появления -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.9" To="1.0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.9" To="1.0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Основной фон с затемнением -->
    <Grid>
        <!-- Полупрозрачный фон для затемнения -->
        <Border Background="Transparent" Opacity="0.3"/>

        <!-- Основное окно сообщения -->
        <Border CornerRadius="12" 
                Background="{StaticResource PureWhiteBrush}" 
                BorderThickness="1" 
                BorderBrush="{StaticResource BorderGrayBrush}"
                RenderTransformOrigin="0.5,0.5"
                Margin="20"
                Effect="{StaticResource CardShadowEffect}">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с иконкой в зависимости от типа сообщения -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка вопроса/информации/предупреждения -->
                    <Border Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{StaticResource SoftGreenBrush}"
                            Margin="0,0,12,0">
                        <TextBlock Text="?" 
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Текст заголовка -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               Style="{StaticResource H4Style}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Сообщение -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="240"
                              Margin="0,0,0,20">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"/>
                </ScrollViewer>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center">

                    <!-- Кнопка подтверждения (OK/Yes) -->
                    <Button Content="{Binding OkButtonText}"
                            Command="{Binding OkCommand}"
                            Style="{StaticResource YesButtonStyle}"
                            Height="38"
                            Padding="20,0"
                            MinWidth="90"
                            Margin="0,0,8,0"/>

                    <!-- Кнопка отмены (Cancel/No) -->
                    <Button Content="{Binding CancelButtonText}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Padding="20,0"
                            MinWidth="90"
                            Visibility="{Binding CancelButtonVisibility}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>