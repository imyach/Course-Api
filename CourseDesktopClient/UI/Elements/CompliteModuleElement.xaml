<UserControl x:Class="CourseDesktopClient.UI.Elements.CompliteModuleElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="320"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource ModuleCardBorderStyle}"
            Width="300"
            Height="Auto"
            MinHeight="180"
            MaxHeight="200"
            Margin="15"
            Padding="20"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок модуля -->
            <TextBlock Grid.Row="0"
                       Text="{Binding ModuleTitle}"
                       Style="{StaticResource H4Style}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Описание модуля -->
            <TextBlock Grid.Row="1"
                       Text="{Binding ModuleDescription}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="70"
                       Margin="0,0,0,8"/>

            <!-- Статус с цветовой индикацией -->
            <Border Grid.Row="2"
                    x:Name="StatusBorder"
                    CornerRadius="12"
                    Padding="8,2"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Не начат">
                                <Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="В прохождении">
                                <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Завершен">
                                <Setter Property="Background" Value="{StaticResource SoftGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="{Binding Status}"
                           FontSize="12"
                           FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Не начат">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="В прохождении">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Завершен">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Дата начала -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,12"
                        Visibility="{Binding StartedAt, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="📅" 
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StartedAt, StringFormat='Начат: {0:dd.MM.yyyy}'}" 
                           Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Кнопка действия -->
            <Button Grid.Row="4"
                    Content="{Binding ContentButton}"
                    Command="{Binding DataContext.PassModuleCommand, 
                            RelativeSource={RelativeSource 
                            AncestorType=UserControl, 
                            AncestorLevel=2}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource ModuleActionButtonStyle}"
                    Height="36"
                    Padding="15,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    SnapsToDevicePixels="True"/>
        </Grid>
    </Border>
</UserControl>