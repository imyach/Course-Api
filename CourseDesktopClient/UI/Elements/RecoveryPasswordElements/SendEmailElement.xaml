<UserControl x:Class="CourseDesktopClient.UI.Elements.RecoveryPasswordElements.SendEmailElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:converter="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Border Background="{StaticResource PureWhiteBrush}"
            Width="480"
            Padding="40"
            CornerRadius="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                              ShadowDepth="4" 
                              Opacity="0.12" 
                              Direction="270"
                              Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Заголовок - используем H1Style из ваших стилей -->
            <TextBlock Text="Восстановление пароля"

                       Style="{StaticResource H1Style}"
                       Margin="0,0,0,8"/>

            <!-- Подзаголовок - используем SecondaryTextStyle -->
            <TextBlock Text="Введите email, привязанный к вашему аккаунту"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,28"/>

            <!-- Поле ввода email -->
            <TextBox Text="{Binding UserEmail}"
                     Style="{StaticResource TextBoxWithIconAndHintStyle}"
                     converter:TextBoxExtensions.IconSource="/UI/Images/icons8-mail-96.png"
                     Tag="youremail@mail.com"
                     Margin="0,0,0,12"
                     Height="48"
                     FontSize="14"/>

            <!-- Кнопка отправки - используем ваш ContinueButtonStyle -->
            <Button Content="Отправить код"
                    Command="{Binding SendCodeCommand}"
                    Style="{StaticResource ContinueButtonStyle}"
                    Margin="0,0,0,12"/>

            <TextBlock Text="{Binding MisstakeText}" 
            Visibility="{Binding VisibleMisstake}"
            Style="{StaticResource ErrorTextStyle}" 
            HorizontalAlignment="Center"
            Margin="0,0,0,15"/>

            <!-- Разделитель -->
            <Border Height="1" 
                    Background="{StaticResource BorderGrayBrush}" 
                    Margin="0,15,0,15"/>

            <TextBlock Text="← Вернуться ко входу" 
           HorizontalAlignment="Center"
           Cursor="Hand" 
           Style="{StaticResource RegisterLinkStyle}"
           VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding LoginCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>