<UserControl x:Class="CourseDesktopClient.UI.Elements.RecoveryPasswordElements.AccountSelectionElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:converter="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:elements="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Border Background="{StaticResource PureWhiteBrush}"
             Width="auto"
             Padding="40"
             CornerRadius="24"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                       ShadowDepth="4" 
                       Opacity="0.12" 
                       Direction="270"
                       Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Выберите аккаунт"
                       HorizontalAlignment="Center"
                       Style="{StaticResource H1Style}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Аккаунты с этим email"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,28"
                       HorizontalAlignment="Center"/>

            <!-- Контейнер для карточек пользователей -->
            <ItemsControl ItemsSource="{Binding Users}"
                          Margin="0,0,0,30">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <elements:SelectionProfileElement 
                            Margin="8"
                            VerticalAlignment="Top"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="← Вернуться к почте" 
HorizontalAlignment="Center"
Cursor="Hand" 
Style="{StaticResource RegisterLinkStyle}"
VerticalAlignment="Center">
     <i:Interaction.Triggers>
         <i:EventTrigger EventName="MouseLeftButtonUp">
             <i:InvokeCommandAction Command="{Binding GoToEmailCommand}"/>
         </i:EventTrigger>
     </i:Interaction.Triggers>
            </TextBlock>

        </StackPanel>
        
    </Border>
</UserControl>
