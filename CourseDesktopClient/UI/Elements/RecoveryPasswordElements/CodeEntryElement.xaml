<UserControl x:Class="CourseDesktopClient.UI.Elements.RecoveryPasswordElements.CodeEntryElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"             
             xmlns:converter="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:elements="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Border Background="{StaticResource PureWhiteBrush}"
             Width="480"
             Padding="40"
             CornerRadius="24"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                       ShadowDepth="4" 
                       Opacity="0.12" 
                       Direction="270"
                       Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Введите код с почты"
                       Style="{StaticResource H1Style}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="На ваш email отправлен 6-значный код подтверждения"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,28"
                       
                       HorizontalAlignment="Center"/>

            <!-- Поле для ввода кода -->
            <TextBox Text="{Binding VerificationCode}"
                     Style="{StaticResource TextBoxWithHintStyle}"
                     converter:TextBoxExtensions.IconSource="/UI/Images/icons8-mail-96.png"
                     Tag="Введите 6-значный код"
                        MaxLength="6"
                     Margin="0,0,0,12"
                     Height="48"/>

            <!-- Кнопка подтверждения -->
            <Button Content="Подтвердить код"
                    Command="{Binding ConfirmCodeCommand}"
                    Style="{StaticResource ContinueButtonStyle}"
                    Margin="0,0,0,12"/>


            <TextBlock Text="{Binding MisstakeText}" 
            Visibility="{Binding VisibleMisstake}"
            Style="{StaticResource ErrorTextStyle}" 
            HorizontalAlignment="Center"
            Margin="0,0,0,15"/>

            <!-- Кнопка повторной отправки (опционально) -->
            <Button Content="Отправить код повторно"
                    Command="{Binding ResendCodeCommand}"
                    Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"
                    IsEnabled="{Binding CanResend}"/>


            <TextBlock Text="← Вернуться к почте" 
HorizontalAlignment="Center"
Cursor="Hand" 
Style="{StaticResource RegisterLinkStyle}"
VerticalAlignment="Center">
     <i:Interaction.Triggers>
         <i:EventTrigger EventName="MouseLeftButtonUp">
             <i:InvokeCommandAction Command="{Binding GoToEmailCommand}"/>
         </i:EventTrigger>
     </i:Interaction.Triggers>
            </TextBlock>

        </StackPanel>

    </Border>
</UserControl>
