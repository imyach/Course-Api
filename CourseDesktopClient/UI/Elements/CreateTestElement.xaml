<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateTestElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="400"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource TestCardBorderStyle}"
            Width="Auto"
            Height="Auto"
            MinHeight="80"
            MaxHeight="100"
            Margin="15"
            Padding="15"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть с информацией о тесте -->
            <StackPanel Grid.Column="0" 
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                <!-- Заголовок теста с иконкой -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="📝" 
                               FontSize="16"
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title, StringFormat='Тест: {0}'}" 
                               Style="{StaticResource H4Style}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"/>
                </StackPanel>
            </StackPanel>

            <!-- Правая часть с кнопками -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                <!-- Кнопка редактирования (иконка) -->
                <Button Command="{Binding DataContext.LocalCreateTestCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource EditIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,5,0"
                        ToolTip="Редактировать тест"/>

                <!-- Кнопка удаления (иконка) -->
                <Button Command="{Binding DataContext.LocalDeleteTestCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DeleteIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTip="Удалить тест"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>