<UserControl x:Class="CourseDesktopClient.UI.Elements.CreateQuestionElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:converters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             Background="Transparent"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource QuestionCardBorderStyle}"
            Width="Auto"
            MinWidth="400"
            HorizontalAlignment="Stretch"
            Height="Auto"
            MinHeight="80"
            MaxHeight="100"
            Margin="15"
            Padding="15"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть с информацией о вопросе -->
            <StackPanel Grid.Column="0" 
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">

                <!-- Заголовок вопроса с иконкой -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="❓" 
                               FontSize="16"
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Text}" 
                               Style="{StaticResource H3Style}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Height="40"
                               Margin=" 0 0 20 0"
                               MaxWidth="1200"
                               Width="auto"
                               />
                </StackPanel>
            </StackPanel>

            <!-- Правая часть с кнопками -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                <!-- Кнопка редактирования (иконка) -->
                <Button Command="{Binding DataContext.LocalCreateQuestionCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource EditIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="0,0,5,0"
                        ToolTip="Редактировать вопрос"/>

                <!-- Кнопка удаления (иконка) -->
                <Button Command="{Binding DataContext.LocalDeleteQuestionCommand, 
                                RelativeSource={RelativeSource 
                                AncestorType=UserControl, 
                                AncestorLevel=2}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource DeleteIconButtonStyle}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTip="Удалить вопрос"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>