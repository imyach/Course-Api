<UserControl x:Class="CourseDesktopClient.View.MyCoursePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controll="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}">

        <Grid Margin="0,0,0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Статистика -->
                <RowDefinition Height="*"/>
                <!-- Контент -->
                <RowDefinition Height="Auto"/>
                <!-- Пагинация -->
            </Grid.RowDefinitions>

            <!-- Заголовок страницы с декоративной линией -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            Margin="35 0 0 0">

                        <!-- Левая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" 
                 Height="6" 
                 Fill="{StaticResource LightGreenBrush}" 
                 Margin="0,0,8,0"
                 Opacity="0.5"/>
                            <Border Width="30" 
                Height="2" 
                Background="{StaticResource LightGreenBrush}" 
                Opacity="0.3"
                Margin="0,0,15,0"/>
                        </StackPanel>

                        <TextBlock Text="МОИ КУРСЫ" 
               Style="{StaticResource PageTitleStyle}" 
               VerticalAlignment="Center"/>

                        <Image Style="{StaticResource IconStyle}"
          Source="/UI/Images/icons8-my-course-page-100.png"
           VerticalAlignment="Center"
           Margin="10, -17,0,0"
           Width="45"
           Height="45"
           Opacity="0.7"/>

                        <!-- Правая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" 
                Height="2" 
                Background="{StaticResource LightGreenBrush}" 
                Opacity="0.3"
                Margin="15,0,8,0"/>
                            <Ellipse Width="6" 
                 Height="6" 
                 Fill="{StaticResource LightGreenBrush}" 
                 Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Rectangle Height="4" 
                           Width="80" 
                           Fill="{StaticResource LightGreenBrush}" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           RadiusX="2" RadiusY="2"/>
            </StackPanel>

            <!-- Статистика курсов (видна только когда есть курсы) -->
            <Border Grid.Row="1" 
                    Style="{StaticResource StatsContainerStyle}"
                    Margin="20,0,20,20"
                    Padding="20,15"
                    Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Завершенные курсы -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Vertical" 
                                HorizontalAlignment="Right"
                                Margin="0,0,30,0">
                        <TextBlock Text="Завершенные курсы" 
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ComplitedCourses}" 
                                   Style="{StaticResource H1Style}"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Вертикальный разделитель -->
                    <Rectangle Grid.Column="1" 
                               Width="1" 
                               Height="40" 
                               Fill="{StaticResource BorderGrayBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0"/>

                    <!-- Курсы в прохождении -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Vertical" 
                                HorizontalAlignment="Left"
                                Margin="30,0,0,0">
                        <TextBlock Text="В прохождении" 
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CourseInPassage}" 
                                   Style="{StaticResource H1Style}"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Пустая страница (показывается когда нет курсов) -->
            <Border Grid.Row="2"
                    Style="{StaticResource EmptyPageStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding VisibleEmptyPage}"
                    Margin="0,50,0,0">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Image Source="/UI/Images/icons8-sad-smile-100.png" 
                           Width="120" 
                           Height="120" 
                           Opacity="0.5"
                           Margin="0,0,0,20"/>

                    <TextBlock Text="Вы ещё не записались ни на один курс" 
                               Style="{StaticResource H4Style}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Самое время это исправить!" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,20"/>

                    <Button Content="К курсам" 
                            Command="{Binding AllCourseCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="200"
                            Height="40"
                            FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Контейнер для карточек курсов (виден когда есть курсы) -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding GetProgressUsers}"
                          Margin="20,0,20,40"
                          Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Анимированное появление карточки -->
                        <Border Opacity="0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <controll:MyCoursePanelElement/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Пагинация с красивым дизайном -->
            <Border Grid.Row="3"
                    Style="{StaticResource PaginationContainerStyle}"
                    Visibility="{Binding VisibleButtonPanel}">

                <ItemsControl ItemsSource="{Binding ButtonPanel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Для обычных кнопок (не троеточие) -->
                                <Button Content="{Binding Text}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Visibility="{Binding IsEllipsis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <!-- Для выбранных кнопок -->
                                <Button Content="{Binding Text}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SelectedPaginationButtonStyle}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Для троеточия -->
                                <TextBlock Text="{Binding Text}" 
                                           Style="{StaticResource EllipsisItemStyle}"
                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>