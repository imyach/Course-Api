<UserControl x:Class="CourseDesktopClient.View.AllCoursePage"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
                xmlns:conveters ="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Конвертер должен быть объявлен ДО его использования -->
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}">

        <Grid Margin="0,0,0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Контент -->
                <RowDefinition Height="Auto"/>
                <!-- Пагинация -->
            </Grid.RowDefinitions>

            <!-- Заголовок страницы с декоративной линией -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" 
  Orientation="Horizontal" 
  HorizontalAlignment="Center" 
  Margin="0 0 0 0">

                        <!-- Левая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" 
       Height="6" 
       Fill="{StaticResource LightGreenBrush}" 
       Margin="0,0,8,0"
       Opacity="0.5"/>
                            <Border Width="30" 
      Height="2" 
      Background="{StaticResource LightGreenBrush}" 
      Opacity="0.3"
      Margin="0,0,15,0"/>
                        </StackPanel>

                        <TextBlock Text="КУРСЫ" 
     Style="{StaticResource PageTitleStyle}" 
     VerticalAlignment="Center"/>

                        <Image Style="{StaticResource IconStyle}"
Source="/UI/Images/icons8-course-page-100.png"
 VerticalAlignment="Center"
 Margin="10, -17,0,0"
 Width="45"
 Height="45"
 Opacity="0.7"/>

                        <!-- Правая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" 
      Height="2" 
      Background="{StaticResource LightGreenBrush}" 
      Opacity="0.3"
      Margin="15,0,8,0"/>
                            <Ellipse Width="6" 
       Height="6" 
       Fill="{StaticResource LightGreenBrush}" 
       Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Rectangle Height="4" 
                           Width="80" 
                           Fill="{StaticResource LightGreenBrush}" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           RadiusX="2" RadiusY="2"/>
            </StackPanel>

            <!-- Пустая страница (показывается когда нет курсов) -->
            <Border Grid.Row="1"
                    Style="{StaticResource EmptyPageStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding VisibleEmptyPage}">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Image Source="/UI/Images/icons8-sad-smile-100.png" 
                           Width="120" 
                           Height="120" 
                           Opacity="0.5"
                           Margin="0,0,0,20"/>

                    <TextBlock Text="Здесь ещё нет ни одного курса" 
                               Style="{StaticResource H4Style}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Подождите, когда авторы создадут курсы" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Контейнер для карточек курсов (виден когда есть курсы) -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding GetCourses}"
                          Margin="20,0,20,40"
                          Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <ItemsControl.Resources>
                    <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
                </ItemsControl.Resources>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Анимированное появление карточки -->
                        <Border Opacity="0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <controls:CoursePanelElement/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Пагинация с красивым дизайном -->
            <Border Grid.Row="2"
        Style="{StaticResource PaginationContainerStyle}"
        Visibility="{Binding VisibleButtonPanel}">

                <ItemsControl ItemsSource="{Binding ButtonPanel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Для обычных кнопок (не троеточие) -->
                                <Button Content="{Binding Text}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource PaginationButtonStyle}"
                            Visibility="{Binding IsEllipsis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <!-- Для выбранных кнопок -->
                                <Button Content="{Binding Text}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SelectedPaginationButtonStyle}"
                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Для троеточия -->
                                <TextBlock Text="{Binding Text}" 
                               Style="{StaticResource EllipsisItemStyle}"
                               Visibility="{Binding IsEllipsis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
