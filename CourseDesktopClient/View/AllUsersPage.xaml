<UserControl x:Class="CourseDesktopClient.View.AllUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controlls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}">

        <Grid Margin="0,0,0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Контент -->
                <RowDefinition Height="Auto"/>
                <!-- Пагинация -->
            </Grid.RowDefinitions>

            <!-- Заголовок страницы с декоративной линией и кнопкой -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20">

                <!-- Верхняя строка с заголовком и кнопкой -->
                <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок с иконкой (по центру) -->
                    <StackPanel Grid.Column="0" 
  Orientation="Horizontal" 
  HorizontalAlignment="Center" 
  Margin="150 0 0 0">

                        <!-- Левая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" 
       Height="6" 
       Fill="{StaticResource LightGreenBrush}" 
       Margin="0,0,8,0"
       Opacity="0.5"/>
                            <Border Width="30" 
      Height="2" 
      Background="{StaticResource LightGreenBrush}" 
      Opacity="0.3"
      Margin="0,0,15,0"/>
                        </StackPanel>

                        <TextBlock Text="ПОЛЬЗОВАТЕЛИ" 
     Style="{StaticResource PageTitleStyle}" 
     VerticalAlignment="Center"/>

                        <Image Style="{StaticResource IconStyle}"
Source="/UI/Images/icons8-users-page-100.png"
 VerticalAlignment="Center"
 Margin="10, -17,0,0"
 Width="45"
 Height="45"
 Opacity="0.7"/>

                        <!-- Правая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" 
      Height="2" 
      Background="{StaticResource LightGreenBrush}" 
      Opacity="0.3"
      Margin="15,0,8,0"/>
                            <Ellipse Width="6" 
       Height="6" 
       Fill="{StaticResource LightGreenBrush}" 
       Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Кнопка добавления пользователя (справа) -->
                    <Border Grid.Column="1"
                            Visibility="{Binding AddUserButtonVisible}">
                        <Button Content="Добавить"
                            Command="{Binding AddUserCommand}"
                            Style="{StaticResource AddUserButtonStyle}"
                            ToolTip="Добавить нового пользователя"/>
                    </Border>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Rectangle Height="4" 
                           Width="80" 
                           Fill="{StaticResource LightGreenBrush}" 
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           RadiusX="2" RadiusY="2"/>
            </StackPanel>

            <!-- Контейнер для карточек пользователей -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding GetUsers}"
                          Margin="20,0,20,40">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Анимированное появление карточки -->
                        <Border Opacity="0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <controlls:UserPanelElement/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Пагинация с красивым дизайном -->
            <Border Grid.Row="2"
                    Style="{StaticResource PaginationContainerStyle}"
                    Visibility="{Binding VisibleButtonPanel}">

                <ItemsControl ItemsSource="{Binding ButtonPanel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Для обычных кнопок (не троеточие) -->
                                <Button Content="{Binding Text}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Visibility="{Binding IsEllipsis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <!-- Для выбранных кнопок -->
                                <Button Content="{Binding Text}"
                                        Command="{Binding Command}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SelectedPaginationButtonStyle}"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Для троеточия -->
                                <TextBlock Text="{Binding Text}" 
                                           Style="{StaticResource EllipsisItemStyle}"
                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>