<UserControl x:Class="CourseDesktopClient.View.CourseInformationPage"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="0 0 0 10">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="Auto"
                        MinWidth="300"
                        MaxWidth="800">
                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"  FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="WrapWithOverflow" Margin="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right"  Margin="0 0 10 10" Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy}'}"/>
                <Button Content="Записаться на курс" Command="{Binding EnrollCommand}"/>
                <Button Content="Назад" Command="{Binding GoBackCommand}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" 
                        MinWidth="300"
                        MaxWidth="800">
                <Separator Margin="20 20  20 10"/>
                <TextBlock Text="Отзывы"/>
                <controls:CreateReveiwsElement />

            </StackPanel>

            <StackPanel Grid.Row="2"
                        MinWidth="300"
                        MaxWidth="800" Margin=" 20 0 20 0" Orientation="Horizontal">
                <TextBlock Text="Сортировать по: " Margin="10 0 10 0"/>
                
                
                <RadioButton Content="Дате" 
                 Margin="5 0 5 0"
                 GroupName="SortField"
                 IsChecked="{Binding SortByDate}"/>

                <RadioButton Content="Оценке"
                 Margin="5 0 5 0"
                 GroupName="SortField"
                 IsChecked="{Binding SortByRating}"/>

                <ToggleButton Margin="10 0 5 0"
                  Width="30"
                  IsChecked="{Binding SortAscending}"
                  Content="{Binding SortDirectionSymbol}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="3" Width="auto" Margin="20 0" MinWidth="300"
MaxWidth="800">
                <ItemsControl ItemsSource="{Binding GetReviews}" 
              HorizontalContentAlignment="Center"
              BorderThickness="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ReviewPanelElement/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1"  ItemsSource="{Binding ButtonPanel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" 
         HorizontalAlignment="Center" 
         VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Text}"
                                 Command="{Binding Command}"
                                 CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" 
                                       Margin="10,0" 
                                       VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Grid>
        </ScrollViewer>
</UserControl>
