<UserControl x:Class="CourseDesktopClient.View.LoginPage"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
                    xmlns:converter ="clr-namespace:CourseDesktopClient.UI.Converters">

    <Grid Background="{StaticResource OffWhiteBrush}">
        <!-- Основной контейнер с максимальной шириной -->
        <Border Background="{StaticResource PureWhiteBrush}"
                Width="450"
                Padding="40"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                          ShadowDepth="3" 
                          Opacity="0.15" 
                          Direction="270"
                          Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">

                <!-- Заголовок с иконкой -->
                <Grid Margin="0,0,0,30" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Авторизация" 
               Grid.Column="0" 
               VerticalAlignment="Center" 
               Style="{StaticResource H1Style}"/>

                    <Image Source="/UI/Images/icons8-pass-96.png" 
           Grid.Column="1" 
           VerticalAlignment="Center" 
           Style="{StaticResource IconStyle}"
           Margin="10,-14,0,0"
                           Opacity="0.69"/>
                    <!-- Отрицательный верхний отступ для поднятия -->
                </Grid>

                <!-- Поле Логин -->
                <TextBlock Text="Логин или Email" 
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding UserLoginText}" 
                         Style="{StaticResource TextBoxWithIconAndHintStyle}" 
                         converter:TextBoxExtensions.IconSource="/UI/Images/icons8-user-60.png"
                         Tag="Введите логин или почту"
                         Margin="0,0,0,20">
                </TextBox>

                <!-- Поле Пароль -->
                <TextBlock Text="Пароль"  
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding UserPasswordText}" 
                         Style="{StaticResource TextBoxWithIconAndHintStyle}"   
                         converter:TextBoxExtensions.IconSource="/UI/Images/icons8-lock-60.png"
                         Tag="Введите пароль"
                         Margin="0,0,0,25"/>

                <!-- Кнопка входа -->
                <Button Content="Войти" 
                        Command="{Binding SignInCommand}" 
                        Style="{StaticResource LoginButtonStyle}"
                        Margin="0,0,0,15"/>

                <!-- Сообщение об ошибке -->
                <TextBlock Text="{Binding MisstakeText}" 
                           Visibility="{Binding VisibleMisstake}"
                           Style="{StaticResource ErrorTextStyle}" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Нижняя панель с чекбоксом и ссылкой -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Запомнить меня" 
                              IsChecked="{Binding CheckedSaveUser}" 
                              Style="{StaticResource LoginCheckBoxStyle}"
                              Grid.Column="0"
                              VerticalAlignment="Center"/>

                    <TextBlock Text="Регистрация" 
                               Grid.Column="1"
                               HorizontalAlignment="Right" 
                               Cursor="Hand" 
                               Style="{StaticResource RegisterLinkStyle}"
                               VerticalAlignment="Center">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonUp">
                                <i:InvokeCommandAction Command="{Binding RegisterCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>