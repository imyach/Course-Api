<UserControl x:Class="CourseDesktopClient.View.LoginPage"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CourseDesktopClient.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Вход" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин или Email"/>
            <TextBox x:Name="LoginTbx" Width="300" Text="{Binding UserLoginText}" />
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="PasswordTbx" Width="300" Text="{Binding UserPasswordText}" />
            <Button Content="Войти" Command="{Binding SignInCommand}"/>
            <TextBlock Text="{Binding MisstakeText}" Visibility="{Binding VisibleMisstake}"/>
            <Grid >
                <CheckBox Content="Запомнить меня" HorizontalAlignment="Left"/>
                <TextBlock Text="Регистрация" HorizontalAlignment="Right">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding RegisterCommand}"/>
                    </i:EventTrigger>
                 </i:Interaction.Triggers>
                </TextBlock>
            </Grid>
                
        </StackPanel>
    </Grid>
</UserControl>
