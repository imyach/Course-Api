<UserControl x:Class="CourseDesktopClient.View.CreateCoursePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Редактор курса" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название курса"  Margin="10"/>
                    <TextBox Text="{Binding TitleOfCourse, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Описание курса"  Margin="10"/>
                    <TextBox Text="{Binding DescroptionOfCourse, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" Width="500" Height="300" Margin="10"/>
                </StackPanel>
            </StackPanel>
            <Button Content="Добaвить модуль" Grid.Row="2" Width="150" Height="30" Margin="10" Visibility="{Binding VisibleAddModuleButton}" HorizontalAlignment="Left" Command="{Binding CreateModuleCommand}"/>

            <Grid  Grid.Row="3" MinHeight="200"   Visibility="{Binding VisibleEmptyPage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="В данном курсе нет модулей" HorizontalAlignment="Center"/>
                    <Button Content="Создать первый модуль" Command="{Binding CreateModuleCommand }"/>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="3" 
ItemsSource="{Binding GetModules}" 
HorizontalContentAlignment="Center"  
BorderThickness="0">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CreateModulePanelElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" 
          HorizontalAlignment="Center"
          VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="В мастерскую"  Width="150" Height="30" Margin="10"  Command="{Binding WorkshopCommand}"/>
                <Button Content="Сохранить изменения" Width="150" Height="30" Margin="10" Command="{Binding SaveUpdateCommand}"/>
                <Button Content="Опубликовать"  Width="150" Height="30" Margin="10"  Command="{Binding PublicCourseCommand}" IsEnabled="{Binding IsPublishEnable}" Visibility="{Binding VisiblePublishButton}"/>
                <Button Content="Снять с публикации"  Width="150" Height="30" Margin="10"  Command="{Binding UnPublicCourseCommand}" Visibility="{Binding VisibleUnPublishButton}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
