<UserControl x:Class="CourseDesktopClient.View.GerenateReportUserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converter="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="932.425" d:DesignWidth="1088" >
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedPageCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource OffWhiteBrush}">
        <Border Background="{StaticResource PureWhiteBrush}"
                Width="550"
                Padding="40"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="4" 
                                  Opacity="0.12" 
                                  Direction="270"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="Формирование отчета"
                           Style="{StaticResource H1Style}"
                           Margin="0,0,0,8"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Выберите параметры для создания отчета"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,28"
                           HorizontalAlignment="Center"/>

                <!-- Название отчета -->
                <TextBlock Text="Название отчета"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding ReportName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxWithIconAndHintStyle}"
                         Tag="Введите название отчета"
                         Height="45"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <!-- Путь сохранения -->
                <TextBlock Text="Путь сохранения"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxWithIconAndHintStyle}"
                             Tag="Выберите папку для сохранения"
                             Height="45"
                             IsEnabled="False"
                             FontSize="14"
                             Grid.Column="0"/>

                    <Button Content="Обзор"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource BrowseButtonStyle}"
                            Grid.Column="1"
                            Margin="10,0,0,0"/>
                </Grid>

                <!-- Группировка по роли -->
                <TextBlock Text="Фильтрация по роли"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding GetRoles}"
                          DisplayMemberPath="Name"
                          HorizontalAlignment="Left"
                          SelectedItem="{Binding SelectedRole}"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectedIndex="0"
                          Height="45"
                          Margin="0,0,0,15"/>

                <Border BorderThickness="1" BorderBrush="{StaticResource BorderGrayBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Период -->
                        <TextBlock Text="Период" 
                                   Grid.Row="0"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal" 
                            Margin="0,0,0,15"
                                   Grid.Row="1"
                            HorizontalAlignment="Left">

                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="200"
                                Margin="0,0,15,0"
                                IsEnabled="{Binding IsAllTime, Converter={StaticResource InverseBooleanConverter}}"/>

                            <TextBlock Text="—"
                               Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                            <DatePicker SelectedDate="{Binding EndDate , UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="200"
                                IsEnabled="{Binding IsAllTime, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>

                        <!-- За все время -->
                        <CheckBox Content="За все время"
                                  
                                   Grid.Row="2"
                          IsChecked="{Binding IsAllTime}"
                          Style="{StaticResource LoginCheckBoxStyle}"
                          />
                    </Grid>
                </Border>

                <!-- Группировка по роли -->
                <TextBlock Text="Формат отчета"
                     Style="{StaticResource FieldLabelStyle}"
                     Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding GetFormat}"
                    HorizontalAlignment="Left"
                    SelectedItem="{Binding SelectedFormat}"
                    Style="{StaticResource ComboBoxStyle}"
                          SelectedIndex="0"
                    Height="45"
                    Margin="0,0,0,25"/>

                <!-- Сообщение об ошибке -->
                <TextBlock Text="{Binding MisstakeText}" 
                        Visibility="{Binding VisibleMisstake}"
                        Style="{StaticResource ErrorTextStyle}" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15"/>

                <!-- Кнопка скачивания -->
                <Button Content="Скачать отчет"
                        Command="{Binding DownloadReportCommand}"
                        Style="{StaticResource DownloadButtonStyle}"
                        Height="48"
                        FontSize="15"
                        Margin="0,0,0,15"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>