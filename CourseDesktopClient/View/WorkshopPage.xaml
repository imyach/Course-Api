<UserControl x:Class="CourseDesktopClient.View.WorkshopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>


    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}">

        <Grid Margin="0,0,0,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок (всегда виден) -->
                <RowDefinition Height="*"/>
                <!-- Контент (пустая страница или курсы) -->
            </Grid.RowDefinitions>

            <!-- Заголовок страницы с декоративной линией и кнопкой (всегда виден) -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20">

                <!-- Верхняя строка с заголовком и кнопкой -->
                <Grid HorizontalAlignment="Stretch" Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок с иконкой (по центру) с декоративными элементами -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="150 0 0 0">

                        <!-- Левая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" 
                                     Height="6" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     Margin="0,0,8,0"
                                     Opacity="0.5"/>
                            <Border Width="30" 
                                    Height="2" 
                                    Background="{StaticResource LightGreenBrush}" 
                                    Opacity="0.3"
                                    Margin="0,0,15,0"/>
                        </StackPanel>

                        <TextBlock Text="МАСТЕРСКАЯ" 
                                   Style="{StaticResource PageTitleStyle}" 
                                   VerticalAlignment="Center"/>

                        <Image Style="{StaticResource IconStyle}"
                               Source="/UI/Images/icons8-workshop-100.png"
                               VerticalAlignment="Center"
                               Margin="10, -17,0,0"
                               Width="45"
                               Height="45"
                               Opacity="0.7"/>

                        <!-- Правая декоративная линия с точкой -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" 
                                    Height="2" 
                                    Background="{StaticResource LightGreenBrush}" 
                                    Opacity="0.3"
                                    Margin="15,0,8,0"/>
                            <Ellipse Width="6" 
                                     Height="6" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопка создания курса (справа) с улучшенным дизайном -->
                    <Border Grid.Column="1"
                            Visibility="{Binding VisibleAddButton}"
                            CornerRadius="20"
                            Padding="3"
                            Effect="{StaticResource CardShadowEffect}">
                        <Button Content="Создать курс"
                                Command="{Binding CreateCourseCommand}"
                                Style="{StaticResource AddUserButtonStyle}"
                                ToolTip="Создать новый курс"
                                Height="38"
                                FontSize="13"
                                FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Grid HorizontalAlignment="Center" Margin="0,15,0,5">
                    <Border Height="4" 
                            Width="100" 
                            Background="{StaticResource LightGreenBrush}" 
                            CornerRadius="2"
                            Opacity="0.8"/>
                    <Ellipse Width="8" 
                             Height="8" 
                             Fill="{StaticResource LightGreenBrush}" 
                             HorizontalAlignment="Center"
                             Margin="0,-2,0,0"/>
                </Grid>
            </StackPanel>

            <!-- ===== ПУСТАЯ СТРАНИЦА (показывается когда нет курсов) ===== -->
            <Border Grid.Row="1"
                    Style="{StaticResource EmptyPageStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding VisibleEmptyPage}"
                    Padding="40"
                    Background="{StaticResource PureWhiteBrush}"
                    CornerRadius="24"
                    Effect="{StaticResource CardShadowEffect}">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            MaxWidth="400">

                    <!-- Анимированная иконка с градиентным фоном -->
                    <Border Background="{StaticResource SoftGreenBrush}"
                            Width="130"
                            Height="130"
                            CornerRadius="65"
                            Margin="0,0,0,25"
                            HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" 
                                              ShadowDepth="3" 
                                              Opacity="0.2" 
                                              Direction="270"
                                              Color="{StaticResource PrimaryGreen}"/>
                        </Border.Effect>
                        <TextBlock Text="🔨" 
                                   FontSize="64"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.9"/>
                    </Border>

                    <TextBlock Text="Мастерская пуста" 
                               Style="{StaticResource H3Style}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Создайте свой первый курс и поделитесь знаниями с миром!" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="22"
                               Margin="0,0,0,25"/>

                    <!-- Кнопка с улучшенным дизайном -->
                    <Button Content="Начать создание курса"
                            Command="{Binding CreateCourseCommand}"
                            Style="{StaticResource AddUserButtonStyle}"
                            Width="250"
                            Height="46"
                            FontSize="15"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource CardShadowEffect}"/>
                </StackPanel>
            </Border>

            <!-- ===== КОНТЕЙНЕР ДЛЯ КАРТОЧЕК КУРСОВ (виден только когда есть курсы) ===== -->
            <StackPanel Grid.Row="1"
                        Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Margin="20,0,20,0">

                <!-- Статистика мастерской (видна только когда есть курсы) -->
                <Border Style="{StaticResource StatCardStyle}"
                        Margin="320,0,320,20"
                        Padding="20,15"
                        Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Всего курсов -->
                        <StackPanel Grid.Column="2" 
                                    Orientation="Vertical" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📊 Всего" 
                                       Style="{StaticResource SmallTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCourses, FallbackValue=0}" 
                                       Style="{StaticResource H2Style}"
                                       Foreground="{StaticResource PrimaryGreenBrush}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Вертикальный разделитель с декоративным элементом -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Rectangle Width="1" 
                                       Height="30" 
                                       Fill="{StaticResource BorderGrayBrush}" 
                                       Opacity="0.3"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="4" 
                                     Height="4" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     HorizontalAlignment="Center"
                                     Margin="0,-15,0,0"/>
                            <Ellipse Width="4" 
                                     Height="4" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     HorizontalAlignment="Center"
                                     Margin="0,15,0,0"/>
                        </Grid>

                        <!-- Вертикальный разделитель с декоративным элементом -->
                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <Rectangle Width="1" 
                                       Height="30" 
                                       Fill="{StaticResource BorderGrayBrush}" 
                                       Opacity="0.3"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="4" 
                                     Height="4" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     HorizontalAlignment="Center"
                                     Margin="0,-15,0,0"/>
                            <Ellipse Width="4" 
                                     Height="4" 
                                     Fill="{StaticResource LightGreenBrush}" 
                                     HorizontalAlignment="Center"
                                     Margin="0,15,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Заголовок секции с фильтрами -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка и заголовок с декоративной линией -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal"
                                Margin="0,0,15,0">
                        <Border Background="{StaticResource SoftGreenBrush}"
                                Width="32"
                                Height="32"
                                CornerRadius="16"
                                Margin="0,0,10,0">
                            <TextBlock Text="📚" 
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Мои курсы"
                                   Style="{StaticResource H4Style}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Сетка карточек -->
                <ItemsControl ItemsSource="{Binding GetCourses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Анимированное появление карточки -->
                            <Border Opacity="0">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                    </EventTrigger>
                                </Border.Triggers>
                                <controls:CreateCoursePanelElement/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Декоративный разделитель перед пагинацией -->
                <Grid Margin="0,25,0,10"
                      Visibility="{Binding VisibleButtonPanel}">
                    <Rectangle Height="1" 
                               Fill="{StaticResource BorderGrayBrush}" 
                               Opacity="0.2"/>
                    <Ellipse Width="6" 
                             Height="6" 
                             Fill="{StaticResource LightGreenBrush}" 
                             HorizontalAlignment="Center"
                             Margin="0,-3,0,0"/>
                </Grid>

                <!-- Пагинация с красивым дизайном -->
                <Border Style="{StaticResource PaginationContainerStyle}"
                        Visibility="{Binding VisibleButtonPanel}"
                        Margin="0,5,0,0">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Номера страниц -->
                        <ItemsControl ItemsSource="{Binding ButtonPanel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Для обычных кнопок (не троеточие) -->
                                        <Button Content="{Binding Text}"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PaginationButtonStyle}"
                                                Visibility="{Binding IsEllipsis, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <!-- Для выбранных кнопок -->
                                        <Button Content="{Binding Text}"
                                                Command="{Binding Command}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SelectedPaginationButtonStyle}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Для троеточия -->
                                        <TextBlock Text="{Binding Text}" 
                                                   Style="{StaticResource EllipsisItemStyle}"
                                                   Visibility="{Binding IsEllipsis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>