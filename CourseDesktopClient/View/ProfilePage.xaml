<UserControl x:Class="CourseDesktopClient.View.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <WrapPanel Orientation="Vertical" HorizontalAlignment="Center"  VerticalAlignment="Center">
            <TextBlock Text="Профиль" FontWeight="Bold" Margin="0 0 0 30"/>
            <TextBlock Text="{Binding UserName, StringFormat='Имя: {0}'}" />
            <TextBlock Text="{Binding UserEmail, StringFormat='Почта: {0}'}" />
            <TextBlock Text="{Binding PhoneNumber, StringFormat='Телефон: {0}'}" />
            <TextBlock Text="{Binding UserLogin, StringFormat='Логин: {0}'}" />
            <TextBlock Text="{Binding UserRole, StringFormat='Роль: {0}'}" />
            <Button Content="Изменить профиль" Command="{Binding UpdateUserProfile}"/>
            <Button Content="Удалить аккаунт" Command="{Binding DeleteUserProfile}"/>
            <Button Content="Выйти" Command="{Binding LogOutCommand}"/>
        </WrapPanel>
    </Grid>
</UserControl>
