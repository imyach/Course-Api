<UserControl x:Class="CourseDesktopClient.View.RegisterPage"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
                    xmlns:converter ="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Background="{StaticResource OffWhiteBrush}">
        <!-- Основной контейнер с максимальной шириной -->
        <Border Background="{StaticResource PureWhiteBrush}"
                Width="500"
                Padding="40"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                          ShadowDepth="3" 
                          Opacity="0.15" 
                          Direction="270"
                          Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          PanningMode="VerticalOnly">
                <StackPanel Orientation="Vertical">

                    <!-- Заголовок с иконкой -->
                    <Grid Margin="0,0,0,25" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Регистрация" 
                       Grid.Column="0" 
                       VerticalAlignment="Center" 
                       Style="{StaticResource PageTitleStyle}"/>

                        <Image Source="/UI/Images/icons8-key-64.png" 
                   Grid.Column="1" 
                   VerticalAlignment="Center" 
                   Style="{StaticResource IconStyle}"
                   Margin="10,-14,0,0"
                               Opacity="0.69"/>
                    </Grid>

                    <!-- Поле Логин -->
                    <TextBlock Text="Логин" 
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserLoginText}" 
                             Style="{StaticResource TextBoxWithIconAndHintStyle}" 
converter:TextBoxExtensions.IconSource="/UI/Images/icons8-user-60.png"
                             Tag="Придумайте логин"
                             Margin="0,0,0,15"/>

                    <!-- Поле Email (необязательно) -->
                    <TextBlock Text="Email (необязательно)"  
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserEmailText}" 
                             Style="{StaticResource TextBoxWithIconAndHintStyle}" 
                             converter:TextBoxExtensions.IconSource="/UI/Images/icons8-mail-96.png"
                             Tag="Введите email"
                             Margin="0,0,0,15"/>

                    <!-- Поле Имя пользователя -->
                    <TextBlock Text="Имя пользователя"  
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserNameText}" 
                             Style="{StaticResource TextBoxWithIconAndHintStyle}" 
converter:TextBoxExtensions.IconSource="/UI/Images/icons8-user-60.png"
                             Tag="Введите ваше имя"
                             Margin="0,0,0,15"/>

                    <!-- Поле Пароль -->
                    <TextBlock Text="Пароль"  
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserPasswordText}" 
                             Style="{StaticResource TextBoxWithIconAndHintStyle}"  
                              converter:TextBoxExtensions.IconSource="/UI/Images/icons8-lock-60.png"
                             Tag="Придумайте пароль"
                             Margin="0,0,0,15"/>

                    <!-- Поле Повтор пароля -->
                    <TextBlock Text="Повтор пароля"  
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserRepeedPasswordText}" 
                             Style="{StaticResource TextBoxWithIconAndHintStyle}"  
                             converter:TextBoxExtensions.IconSource="/UI/Images/icons8-lock-60.png"
                             Tag="Повторите пароль"
                             Margin="0,0,0,15"/>

                    <!-- Поле Номер телефона (необязательно) -->
                    <TextBlock Text="Номер телефона (необязательно)"  
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding UserPhoneNumber}" 
                              Style="{StaticResource TextBoxWithIconAndHintStyle}" 
 converter:TextBoxExtensions.IconSource="/UI/Images/icons8-telephone-100.png"
                             Tag="+7 (999) 999-99-99"
                             Margin="0,0,0,25"/>

                    <!-- Кнопка регистрации -->
                    <Button Content="Зарегистрироваться" 
                            Command="{Binding SignUpCommand}" 
                            Style="{StaticResource RegistrationButtonStyle}"
                            Margin="0,0,0,15"/>

                    <!-- Сообщение об ошибке -->
                    <TextBlock Text="{Binding MisstakeText}" 
                               Visibility="{Binding VisibleMisstake}"
                               Style="{StaticResource ErrorTextStyle}" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <!-- Нижняя панель с чекбоксом и ссылкой -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Content="Запомнить меня" 
                                  IsChecked="{Binding CheckedSaveUser}" 
                                  Style="{StaticResource LoginCheckBoxStyle}"
                                  Grid.Column="0"
                                  VerticalAlignment="Center"/>

                        <TextBlock Text="Вход" 
                                   Grid.Column="1"
                                   HorizontalAlignment="Right" 
                                   Cursor="Hand" 
                                   Style="{StaticResource RegisterLinkStyle}"
                                   VerticalAlignment="Center">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding LoginCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>