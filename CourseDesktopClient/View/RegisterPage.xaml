<UserControl x:Class="CourseDesktopClient.View.RegisterPage"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Регистрация" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginTbx" Width="300"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailTbx" Width="300"/>
            <TextBlock Text="Имя пользователя"/>
            <TextBox x:Name="NameUserTbx" Width="300"/>
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="PasswordTbx" Width="300"/>
            <TextBlock Text="Повтор пароля"/>
            <TextBox x:Name="RepetPasswordTbx" Width="300"/>
            <TextBlock Text="Номер телефона"/>
            <TextBox x:Name="PhoneTbx" Width="300"/>
            <Button Content="Зарегистрироваться"/>
            <Grid >
                <CheckBox Content="Запомнить меня" HorizontalAlignment="Left"/>
                <TextBlock Text="Вход" HorizontalAlignment="Right">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonUp">
                            <i:InvokeCommandAction Command="{Binding LoginCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBlock>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
