<UserControl x:Class="CourseDesktopClient.View.CreateMaterialPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"             
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Редактор материала" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Тема"  Margin="10"/>
                    <TextBox Text="{Binding TitleOfMaterial, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Содержание"  Margin="10"/>
                    <TextBox Grid.Column="1" 
                 Text="{Binding DescroptionOfMaterial, UpdateSourceTrigger=PropertyChanged}" 
                 TextWrapping="Wrap"
                 Margin="10,10,20,0"
                 HorizontalAlignment="Stretch"
                 Height="300"/>
                </Grid>
            </StackPanel>
            <Button Content="Добaвить тест" Grid.Row="2" Width="150" Height="30" Margin="10" Visibility="{Binding VisibleAddTestButton}" HorizontalAlignment="Left" Command="{Binding CreateTestCommand}"/>

            <Grid  Grid.Row="3" MinHeight="200"   Visibility="{Binding VisibleEmptyPage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="В данном материале нет тестов" HorizontalAlignment="Center"/>
                    <Button Content="Создать первый тест" Command="{Binding CreateTestCommand }"/>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding GetTest}" 
     HorizontalContentAlignment="Center"
     BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CreateTestElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="К модулю"  Width="150" Height="30" Margin="10"  Command="{Binding LocalTestCommand}"/>
                <Button Content="Сохранить изменения" Width="150" Height="30" Margin="10" Command="{Binding SaveUpdateCommand}" IsEnabled="{Binding IsSaveEnable}"/>
                <Button Content="Удалить материал"  Width="150" Height="30" Margin="10"  Command="{Binding DeleteMaterialCommand}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>

