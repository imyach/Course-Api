<UserControl x:Class="CourseDesktopClient.View.CompletingTestResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:elements="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conveters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

        <Grid Margin="0,0,0,30" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Информация о тесте -->
                <RowDefinition Height="Auto"/>
                <!-- Вопросы -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки действий -->
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК СТРАНИЦЫ ===== -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20"
                        SnapsToDevicePixels="True">

                <Grid HorizontalAlignment="Center" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая декоративная линия -->
                    <Border Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="ПРОХОЖДЕНИЕ ТЕСТА" 
                                   Style="{StaticResource PageTitleStyle}" 
                                   FontSize="26"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Правая декоративная линия -->
                    <Border Grid.Column="2"
                            Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Border Height="4" 
                        Width="100" 
                        Background="{StaticResource LightGreenBrush}" 
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        CornerRadius="2"
                        Opacity="0.8"/>
            </StackPanel>

            <!-- ===== ИНФОРМАЦИЯ О ТЕСТЕ ===== -->
            <Border Grid.Row="1"
                    Style="{StaticResource TestInfoCardStyle}"
                    Margin="50,0,50,30"
                    Padding="25"
                    SnapsToDevicePixels="True">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            MaxWidth="600"
                            SnapsToDevicePixels="True">

                    <!-- Название теста -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <TextBlock Text="📌" 
                                   FontSize="18"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, StringFormat='Тест: {0}'}" 
                                   Style="{StaticResource H3Style}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Описание теста -->
                    <Border CornerRadius="8"
                            Padding="15"
                            Background="{StaticResource OffWhiteBrush}"
                             Visibility="{Binding VisibleDescriptionBorder}">
                        <TextBlock Text="{Binding Description}" 
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== ЗАГОЛОВОК ВОПРОСОВ ===== -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="50,0,0,15"
                        SnapsToDevicePixels="True">
                <Border Background="{StaticResource SoftGreenBrush}"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        Margin="0,0,10,0">
                    <TextBlock Text="❓" 
                               FontSize="16"
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Вопросы теста"
                           Style="{StaticResource H4Style}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Счетчик вопросов -->
                <Border Background="{StaticResource SoftGreenBrush}"
                        CornerRadius="12"
                        Padding="8,2"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding GetQuestion.Count, StringFormat='Всего: {0}'}" 
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               FontSize="11"
                               FontWeight="Medium"/>
                </Border>
            </StackPanel>

            <!-- ===== СПИСОК ВОПРОСОВ ===== -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding GetQuestion}"
                          Margin="30,0,30,30"
                          SnapsToDevicePixels="True">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Контейнер для вопроса -->
                        <Border Style="{StaticResource QuestionCardStyle}"
                                Margin="0,0,0,20"
                                Padding="20"
                                SnapsToDevicePixels="True">

                            <StackPanel>

                                <!-- Текст вопроса с иконкой -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="❓" 
                                               FontSize="16"
                                               Foreground="{StaticResource PrimaryGreenBrush}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TextQuestion}" 
                                               Style="{StaticResource H4Style}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Инструкция -->
                                <TextBlock Text="Выберите ответ(ы), который считаете верным:" 
                                           Style="{StaticResource SmallTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,12"
                                           FontSize="12"/>

                                <!-- Список ответов -->
                                <ItemsControl ItemsSource="{Binding Answers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Контейнер для ответа -->
                                            <Border Style="{StaticResource AnswerOptionStyle}"
                                                    Margin="0,0,0,8"
                                                    Padding="12,10">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Чекбокс для выбора -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              Style="{StaticResource AnswerCheckBoxStyle}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"/>

                                                    <!-- Текст ответа -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TextAnswer}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"/>
                                                </Grid>

                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== КНОПКИ ДЕЙСТВИЙ ===== -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30"
                        SnapsToDevicePixels="True">

                <!-- Кнопка "Завершить тест" -->
                <Button Content="Завершить тест"
                        Command="{Binding СompletionTestCommand}"
                        Style="{StaticResource CompleteTestButtonStyle}"
                        Height="44"
                        Padding="25,0"
                        Margin="0,0,15,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        SnapsToDevicePixels="True"/>

                <!-- Кнопка "Назад к материалу" -->
                <Button Content="← Назад к материалу"
                        Command="{Binding PassMaterialCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="44"
                        Padding="25,0"
                        FontSize="13"
                        FontWeight="Medium"
                        SnapsToDevicePixels="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>