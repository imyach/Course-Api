<UserControl x:Class="CourseDesktopClient.View.CompletingTestResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:elements="clr-namespace:CourseDesktopClient.UI.Elements"
    xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top"
    Width="Auto"
            MinWidth="300"
            MaxWidth="800">
                <TextBlock Text="{Binding Title, StringFormat='Тест: {0}'}" HorizontalAlignment="Center"  FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="20" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding GetQuestion}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Контейнер для вопроса -->
                        <Border BorderBrush="#CCCCCC" 
                                BorderThickness="1" 
                                CornerRadius="5"
                                Padding="15"
                                Margin="0,0,0,15"
                                Background="White">

                            <StackPanel>

                                <!-- Текст вопроса -->
                                <TextBlock Text="{Binding TextQuestion}" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <!-- Список ответов -->
                                <StackPanel>
                                    <TextBlock Text="Варианты ответов (выберите ответ(ы), который считаете верным):" 
                                               FontSize="12" 
                                               Foreground="Gray"
                                               Margin="0,0,0,5"/>

                                    <ItemsControl ItemsSource="{Binding Answers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <!-- Контейнер для ответа -->
                                                <Border Background="White" 
                                                        BorderBrush="#EEEEEE" 
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="10,8"
                                                        Margin="0,2,0,2">

                                                    <StackPanel Orientation="Horizontal">

                                                        <!-- Чекбокс для выбора -->
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"/>

                                                        <!-- Текст ответа -->
                                                        <TextBlock Text="{Binding TextAnswer}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"/>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Row="2" Content="Завершить тест" Command="{Binding СompletionTestCommand}"/>
            <Button Grid.Row="3" Content="Назад к материалу" Command="{Binding PassMaterialCommand}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
