<UserControl x:Class="CourseDesktopClient.View.CompletingMaterialPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conveters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

        <Grid Margin="0,0,0,30" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Информация о материале -->
                <RowDefinition Height="Auto"/>
                <!-- Тесты -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Кнопка назад -->
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК СТРАНИЦЫ ===== -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,20"
                        SnapsToDevicePixels="True">

                <Grid HorizontalAlignment="Center" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая декоративная линия -->
                    <Border Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="ПРОХОЖДЕНИЕ МАТЕРИАЛА" 
                                   Style="{StaticResource PageTitleStyle}" 
                                   FontSize="26"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Правая декоративная линия -->
                    <Border Grid.Column="2"
                            Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Border Height="4" 
                        Width="100" 
                        Background="{StaticResource LightGreenBrush}" 
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        CornerRadius="2"
                        Opacity="0.8"/>
            </StackPanel>

            <!-- ===== ИНФОРМАЦИЯ О МАТЕРИАЛЕ ===== -->
            <Border Grid.Row="1"
                    Style="{StaticResource MaterialInfoCardStyle}"
                    Margin="50,0,50,30"
                    Padding="25"
                    SnapsToDevicePixels="True">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            MaxWidth="600"
                            SnapsToDevicePixels="True">

                    <!-- Название материала -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <TextBlock Text="📌" 
                                   FontSize="18"
                                   Foreground="{StaticResource PrimaryGreenBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" 
                                   Style="{StaticResource H3Style}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Описание материала -->
                    <Border CornerRadius="8"
                            Padding="15"
                            Background="{StaticResource OffWhiteBrush}"
                            Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock conveters:HyperlinkHelper.FormattedText="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== ЗАГОЛОВОК ТЕСТОВ ===== -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="50,0,0,15"
                        SnapsToDevicePixels="True">
                <Border Background="{StaticResource SoftGreenBrush}"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        Margin="0,0,10,0">
                    <TextBlock Text="📝" 
                               FontSize="16"
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Тесты материала"
                           Style="{StaticResource H4Style}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <!-- Счетчик тестов -->
                <Border Background="{StaticResource SoftGreenBrush}"
                        CornerRadius="12"
                        Padding="8,2"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding GetTestsResults.Count, StringFormat='Всего: {0}'}" 
                               Foreground="{StaticResource PrimaryGreenBrush}"
                               FontSize="11"
                               FontWeight="Medium"/>
                </Border>
            </StackPanel>

            <!-- ===== КОНТЕЙНЕР ДЛЯ ТЕСТОВ ===== -->
            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding GetTestsResults}"
                          Margin="30,0,30,30"
                          SnapsToDevicePixels="True">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:TestResultElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" 
                                    HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===== КНОПКА НАЗАД ===== -->
            <Border Grid.Row="4"
                    Margin="30,0,30,30"
                    Padding="0"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True">

                <Button Content="← Назад к модулю"
                        Command="{Binding PassModuleCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Padding="25,0"
                        FontSize="13"
                        FontWeight="Medium"
                        SnapsToDevicePixels="True"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>