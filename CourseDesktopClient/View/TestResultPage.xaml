<UserControl x:Class="CourseDesktopClient.View.TestResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="{Binding TestTitle}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Статус и результат -->
            <Border Background="{Binding TestStatusColor}"
                    Padding="15"
                    CornerRadius="5"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TestStatus}" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding CompletionDateText,  StringFormat=' {0} (Utc)'}" 
                                   Foreground="White"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ScoreText}" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding PassingScoreText}" 
                                   Foreground="White"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Список вопросов -->
            <TextBlock Text="Детали по вопросам:" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding AnswerUserElements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:AnswerUserElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Кнопка назад -->
            <Button Content="Назад"
                    Command="{Binding PassMaterialCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Padding="30,10"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
