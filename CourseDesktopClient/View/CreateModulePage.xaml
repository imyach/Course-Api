<UserControl x:Class="CourseDesktopClient.View.CreateModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Редактор модуля" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Название модуля"  Margin="10"/>
                    <TextBox Text="{Binding TitleOfModule, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Описание модуля"  Margin="10"/>
                    <TextBox Text="{Binding DescroptionOfModule, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" Width="500" Height="300" Margin="10"/>
                </StackPanel>
            </StackPanel>
            <Button Content="Добaвить материал" Grid.Row="2" Width="150" Height="30" Margin="10" Visibility="{Binding VisibleAddMaterialButton}" HorizontalAlignment="Left" Command="{Binding CreateMaterialCommand}"/>

            <Grid  Grid.Row="3" MinHeight="200"   Visibility="{Binding VisibleEmptyPage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="В данном модуле нет материалов" HorizontalAlignment="Center"/>
                    <Button Content="Создать первый материал" Command="{Binding CreateMaterialCommand }"/>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding GetMaterial}" 
     HorizontalContentAlignment="Center"
     BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CreateMaterialElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="К курсу"  Width="150" Height="30" Margin="10"  Command="{Binding LocalCreateCourseCommand}"/>
                <Button Content="Сохранить изменения" Width="150" Height="30" Margin="10" Command="{Binding SaveUpdateCommand}" IsEnabled="{Binding IsSaveEnable}"/>
                <Button Content="Удалить модуль"  Width="150" Height="30" Margin="10"  Command="{Binding DeleteModuleCommand}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>

