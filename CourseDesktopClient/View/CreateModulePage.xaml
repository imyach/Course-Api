<UserControl x:Class="CourseDesktopClient.View.CreateModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:controls="clr-namespace:CourseDesktopClient.UI.Elements"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conveters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource BaseScrollViewerStyle}"
                  Background="{StaticResource OffWhiteBrush}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

        <Grid Margin="0,0,0,30" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Форма модуля -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка добавления материала -->
                <RowDefinition Height="Auto"/>
                <!-- Материалы или пустая страница -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки действий -->
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК СТРАНИЦЫ ===== -->
            <StackPanel Grid.Row="0" 
                        Orientation="Vertical" 
                        Margin="0,30,0,30"
                        SnapsToDevicePixels="True">

                <Grid HorizontalAlignment="Center" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая декоративная линия -->
                    <Border Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="РЕДАКТОР МОДУЛЯ" 
                               Style="{StaticResource PageTitleStyle}" 
                               VerticalAlignment="Center"/>

                    <!-- Правая декоративная линия -->
                    <Border Grid.Column="2"
                            Width="40" 
                            Height="2" 
                            Background="{StaticResource LightGreenBrush}" 
                            Opacity="0.3"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Border Height="4" 
                        Width="100" 
                        Background="{StaticResource LightGreenBrush}" 
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        CornerRadius="2"/>
            </StackPanel>

            <!-- ===== ФОРМА МОДУЛЯ ===== -->
            <Border Grid.Row="1"
                    Style="{StaticResource CreateCourseFormStyle}"
                    Margin="50,0,50,30"
                    Padding="30"
                    SnapsToDevicePixels="True">

                <StackPanel Orientation="Vertical" SnapsToDevicePixels="True">

                    <!-- Название модуля -->
                    <Grid Margin="0,0,0,20" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📌" 
                                       FontSize="16"
                                       Foreground="{StaticResource PrimaryGreenBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Название модуля" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding TitleOfModule, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxWithHintStyle}"
                                 Tag="Введите название модуля"
                                 Height="40"
                                 SnapsToDevicePixels="True"/>
                    </Grid>

                    <!-- Описание модуля -->
                    <Grid Margin="0,0,0,10" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0">
                            <TextBlock Text="📝" 
                                       FontSize="16"
                                       Foreground="{StaticResource PrimaryGreenBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Описание модуля" 
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 Text="{Binding DescroptionOfModule, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ReviewTextBoxStyle}"
                                 Tag="Введите описание модуля..."
                                 Height="120"
                                 MaxHeight="300"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 SnapsToDevicePixels="True"/>
                    </Grid>
                    <!-- Сообщение об ошибке -->
                    <TextBlock Text="{Binding MistakeText}" 
                Style="{StaticResource ErrorTextStyle}"
         Visibility="{Binding VisibleMisstake}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
             Margin="0,0,0,15"/>
                </StackPanel>
            </Border>

            <!-- ===== КНОПКА ДОБАВЛЕНИЯ МАТЕРИАЛА ===== -->
            <Border Grid.Row="2"
                    Margin="50,0,50,30"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Visibility="{Binding VisibleAddMaterialButton}"
                    SnapsToDevicePixels="True">

                <Button Content="Добавить материал"
                        Command="{Binding CreateMaterialCommand}"
                        Style="{StaticResource AddModuleButtonStyle}"
                        Height="42"
                        Padding="20,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        SnapsToDevicePixels="True"/>
            </Border>

            <!-- ===== ПУСТАЯ СТРАНИЦА (нет материалов) ===== -->
            <Border Grid.Row="3"
                    Style="{StaticResource EmptyPageStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding VisibleEmptyPage}"
                    Margin="50,0,50,40"
                    Padding="40"
                    Background="{StaticResource PureWhiteBrush}"
                    CornerRadius="24"
                    Effect="{StaticResource CardShadowEffect}"
                    SnapsToDevicePixels="True">

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            MaxWidth="400"
                            SnapsToDevicePixels="True">

                    <Border Background="{StaticResource SoftGreenBrush}"
                            Width="100"
                            Height="100"
                            CornerRadius="50"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                        <TextBlock Text="📄" 
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"/>
                    </Border>

                    <TextBlock Text="В модуле пока нет материалов" 
                               Style="{StaticResource H4Style}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Добавьте материалы, чтобы наполнить модуль содержанием" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,25"/>

                    <Button Content="Создать первый материал" 
                            Command="{Binding CreateMaterialCommand}"
                            Style="{StaticResource AddModuleButtonStyle}"
                            Width="auto"
                            Height="44"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource CardShadowEffect}"/>
                </StackPanel>
            </Border>

            <!-- ===== КОНТЕЙНЕР ДЛЯ МАТЕРИАЛОВ ===== -->
            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding GetMaterial}"
                          Margin="30,0,30,40"
                          Visibility="{Binding VisibleEmptyPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          SnapsToDevicePixels="True">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:CreateMaterialElement/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===== КНОПКИ ДЕЙСТВИЙ ===== -->
            <Border Grid.Row="4"
                    Style="{StaticResource ActionButtonsPanelStyle}"
                    Margin="30,0,30,30"
                    Padding="20"
                    SnapsToDevicePixels="True">

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            SnapsToDevicePixels="True">

                    <!-- Кнопка "К курсу" -->
                    <Button Content="← К курсу"
                            Command="{Binding LocalCreateCourseCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="40"
                            Padding="20,0"
                            Margin="0,0,10,0"
                            FontSize="13"
                            SnapsToDevicePixels="True"/>

                    <!-- Кнопка "Сохранить изменения" -->
                    <Button Content="💾 Сохранить"
                            Command="{Binding SaveUpdateCommand}"
                            Style="{StaticResource SaveModuleButtonStyle}"
                            Height="40"
                            Padding="20,0"
                            Margin="0,0,10,0"
                            FontSize="13"
                            IsEnabled="{Binding IsSaveEnable}"
                            SnapsToDevicePixels="True"/>

                    <!-- Кнопка "Удалить модуль" -->
                    <Button Content="🗑️ Удалить"
                            Command="{Binding DeleteModuleCommand}"
                            Style="{StaticResource DeleteModuleButtonStyle}"
                            Height="40"
                            Padding="20,0"
                            FontSize="13"
                            SnapsToDevicePixels="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>