<UserControl x:Class="CourseDesktopClient.View.PasswordRecoveryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:elements="clr-namespace:CourseDesktopClient.UI.Elements.RecoveryPasswordElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource OffWhiteBrush}">

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <elements:AccountSelectionElement Visibility="{Binding AccountSelectionElementVisible}"/>
            <elements:CodeEntryElement Visibility="{Binding CodeEntryElementVisible}"/>
            <elements:SendEmailElement Visibility="{Binding SendEmailElementVisible}"/>
        </Grid>
    </Grid>
</UserControl>
