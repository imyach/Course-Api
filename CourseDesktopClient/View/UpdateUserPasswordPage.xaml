<UserControl x:Class="CourseDesktopClient.View.UpdateUserPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             xmlns:conveters="clr-namespace:CourseDesktopClient.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <conveters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource OffWhiteBrush}">
        <!-- Основной контейнер -->
        <Border Background="{StaticResource PureWhiteBrush}"
                Width="450"
                Padding="40"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Effect="{StaticResource CardShadowEffect}">

            <StackPanel Orientation="Vertical">

                <!-- Заголовок с иконкой -->
                <Grid Margin="0,0,0,30" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ИЗМЕНЕНИЕ ПАРОЛЯ" 
                               Grid.Column="0" 
                               VerticalAlignment="Center" 
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="22"/>

                    <Image Source="/UI/Images/icons8-pass-96.png" 
                           Grid.Column="1" 
                           VerticalAlignment="Center" 
                           Style="{StaticResource IconStyle}"
                           Margin="10,-17,0,0"
                           Width="40"
                           Height="40"
                           Opacity="0.7"/>
                </Grid>

                <!-- Декоративная линия под заголовком -->
                <Border Height="2" 
                        Width="80" 
                        Background="{StaticResource LightGreenBrush}" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30"
                        CornerRadius="1"/>

                <!-- Старый пароль -->
                <TextBlock Text="Старый пароль" 
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding UserOldPasswordText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource TextBoxWithHintStyle}" 
                         Tag="Введите старый пароль"
                         Margin="0,0,0,20"/>

                <!-- Новый пароль -->
                <TextBlock Text="Новый пароль"  
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding UserNewPasswordText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource TextBoxWithHintStyle}"   
                         Tag="Введите новый пароль"
                         Margin="0,0,0,20"/>

                <!-- Повтор пароля -->
                <TextBlock Text="Повтор пароля"  
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding UserNewRepPasswordText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource TextBoxWithHintStyle}"   
                         Tag="Повторите новый пароль"
                         Margin="0,0,0,15"/>

                <!-- Сообщение об ошибке -->
                <TextBlock Text="{Binding MistakeText}" 
                               Style="{StaticResource ErrorTextStyle}"
                        Visibility="{Binding VisibleMisstake}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                            Margin="0,0,0,15"/>
                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка сохранения -->
                    <Button Grid.Column="0"
                            Content="Сохранить"
                            Command="{Binding SaveNewPassword}"
                            Style="{StaticResource SaveProfileButtonStyle}"
                            Height="40"
                            Margin="0,0,5,0"
                            FontSize="13"/>

                    <!-- Кнопка назад -->
                    <Button Grid.Column="1"
                            Content="Назад"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource BackButtonStyle}"
                            Height="40"
                            Margin="5,0,0,0"
                            FontSize="13"/>
                </Grid>

                <!-- Подсказка по безопасности -->
                <TextBlock Text="Пароль должен содержать не менее 5 символов"
                           Style="{StaticResource SmallTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>