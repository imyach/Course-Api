<UserControl x:Class="CourseDesktopClient.View.UpdateUserPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CourseDesktopClient.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Width="220" MaxWidth="320"   Orientation="Vertical" HorizontalAlignment="Center"  VerticalAlignment="Center">
            <TextBlock Text="Изменение пароля" FontWeight="Bold" Margin="0 0 0 30" HorizontalAlignment="Center"/>
            <TextBlock Text="Старый пароль" />
            <TextBox Text="{Binding UserOldPasswordText}" />
            <TextBlock Text="Новый пароль" />
            <TextBox Text ="{Binding UserNewPasswordText}" />
            <TextBlock Text="Повтор пароля" />
            <TextBox Text="{Binding UserNewRepPasswordText}" />
                <TextBlock Text="{Binding MistakeText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MistakeText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            <Button Content="Сохранить изменения" Command="{Binding SaveNewPassword}"/>
            <Button Content="Назад" Command="{Binding GoBackCommand}"/>
        </StackPanel>
        
    </Grid>
</UserControl>
