<Window x:Class="CourseDesktopClient.MainWindow"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseDesktopClient"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="450" MinWidth="1000" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <WrapPanel  Margin="30 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" >
                <WrapPanel Visibility="{Binding VisibilitySearch}">
                    <TextBlock Text="Поиск"   />
                    <TextBox Width="150" Height="14" Margin="3 0 0 0" 
         Text="{Binding SearchCourse, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <TextBlock Text="Курсы" HorizontalAlignment="Right" VerticalAlignment="Center" Margin=" 0 0 30 0">
                     <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonUp">
                            <i:InvokeCommandAction Command="{Binding AllCourseCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBlock>
            </WrapPanel>


            <WrapPanel   HorizontalAlignment="Right" VerticalAlignment="Center" >

                <Menu Visibility="{Binding VisibilityProfileButton}" 
                    Margin="0 0 30 0"
                    Background="Transparent"
                    BorderBrush="Transparent">

                    <MenuItem Header="{Binding UserName}" 
                  FontWeight="Bold"
                  Background="Transparent">

                        <MenuItem Header="{Binding UserName}" 
                      Command="{Binding ProfileCommand}"/>

                        <Separator/>

                        <MenuItem Header="Мои курсы" 
                      Command="{Binding MyCourseCommand}"/>

                        <MenuItem Header="Выйти" 
                      Command="{Binding LogOutCommand}"/>
                        
                    </MenuItem>
                </Menu>



                <TextBlock Text="Войти"  Visibility="{Binding VisibilitySignInButton}" HorizontalAlignment="Right" Margin=" 0 0 30 0" VerticalAlignment="Center" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding LoginCommand, UpdateSourceTrigger=PropertyChanged}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                </TextBlock>
            </WrapPanel>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

    </Grid>
</Window>
