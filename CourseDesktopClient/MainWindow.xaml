<Window x:Class="CourseDesktopClient.MainWindow"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseDesktopClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded" >
            <i:InvokeCommandAction Command="{Binding Loaded}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <WrapPanel  Margin="30 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" >
                <WrapPanel Visibility="{Binding VisibilitySearch}">
                    <TextBlock Text="Поиск"   />
                    <TextBox Width="150" Height="14" Margin=" 3 0 0 0"  />
                </WrapPanel>
                <TextBlock Text="Курсы" HorizontalAlignment="Right" VerticalAlignment="Center" Margin=" 0 0 30 0">
                     <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonUp">
                            <i:InvokeCommandAction Command="{Binding AllCourseCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBlock>
            </WrapPanel>
            <TextBlock Text="Войти" HorizontalAlignment="Right" VerticalAlignment="Center" Margin=" 0 0 30 0">
                <i:Interaction.Triggers>
                   <i:EventTrigger EventName="MouseLeftButtonUp">
                       <i:InvokeCommandAction Command="{Binding LoginCommand, UpdateSourceTrigger=PropertyChanged}"/>
                   </i:EventTrigger>
               </i:Interaction.Triggers>
            </TextBlock>
            <TextBlock Text="выйти" HorizontalAlignment="Right" VerticalAlignment="Center" Margin=" 0 0 100 0">
                 <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding LogOut, UpdateSourceTrigger=PropertyChanged}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
        
        
        
    </Grid>
</Window>
